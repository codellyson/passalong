{
  "name": "passalong-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Passalong: hand a finished implementation from one context to another, in a form an agent can act on.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @passalong/web dev",
    "release": "node scripts/release.mjs",
    "metrics": "node scripts/metrics.mjs",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  }
}
