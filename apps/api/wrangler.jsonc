{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passalong-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Static files (stylesheet, icons, robots.txt, 404 page) are served straight from the edge,
  // before the Worker runs; anything not in public/ falls through to the Hono app. The binding
  // lets the app serve 404.html itself for unmatched routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },

  // One host for the API, the share links, and the landing page. A one-level subdomain, so
  // Cloudflare's free Universal SSL covers it. Wrangler creates the DNS record on deploy.
  "routes": [{ "pattern": "passalong.kreativekorna.com", "custom_domain": true }],

  // Account creation is the only unauthenticated write. Per-IP throttle so a script cannot
  // fill the account table; `namespace_id` just has to be unique within this account.
  "ratelimits": [
    { "name": "ACCOUNT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passalong",
      // An identifier, not a secret: it names the database, not who may use it.
      "database_id": "1c3e3932-242d-4e7f-ae3e-09c598b6a5ca",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // Free tier: how many published/promoted guides one account may keep synced.
    // Local guides are unlimited; this only gates the hosted copy.
    "FREE_SYNC_LIMIT": "25",
    // Sender for handoff/invite mail; only used when the BREVO_API_KEY secret is set.
    "EMAIL_FROM": "no-reply@passalong.kreativekorna.com"
  }
}
