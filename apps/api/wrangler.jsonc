{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passalong-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // **No routes, no assets, and this Worker is no longer deployed.** At the cutover its Hono app
  // became a module that apps/web mounts (apps/web/server/middleware/1.api.ts), so `/v1/*`,
  // `/health` and the two machine routes are served from there — on the same origin as the pages,
  // which is what lets the session cookie and the bearer token keep working unchanged. The three
  // custom domains moved to apps/web/wrangler.jsonc, and `public/` moved with them: the `ASSETS`
  // binding `src/og.ts` reads its fonts through is apps/web's now.
  //
  // This file stays because `wrangler d1 migrations` reads it — that is the only thing that still
  // does. `pnpm dev` runs apps/web, which serves this app mounted.

  // Account creation is the only unauthenticated write. Per-IP throttle so a script cannot
  // fill the account table; `namespace_id` just has to be unique within this account.
  "ratelimits": [
    { "name": "ACCOUNT_LIMIT", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } },
    // OAuth dynamic client registration (POST /v1/oauth/register), the other unauthenticated
    // write. Looser than sign-up: one connect can register more than once. Mirrors apps/web.
    {
      "name": "OAUTH_REGISTER_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Outbound mail (handoffs, pulls, invites) through Cloudflare Email Service. No API key: the
  // binding is the credential. EMAIL_FROM's domain must be onboarded to Email Service, and
  // sending to addresses outside the account needs the Workers Paid plan.
  "send_email": [{ "name": "EMAIL" }],

  "r2_buckets": [
    {
      "binding": "SHOTS",
      "bucket_name": "passalong-shots"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passalong",
      // An identifier, not a secret: it names the database, not who may use it.
      "database_id": "1c3e3932-242d-4e7f-ae3e-09c598b6a5ca",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // The host every link the app mints points at, whichever host served the request.
    //
    // `origin()` used to fall back to the request's own origin, so `passalong.kreativekorna.com`
    // minted share links, invite links, reset links and screenshot URLs under itself — which is
    // the same problem the www route exists to avoid, one guide with two links and a share key in
    // each. The old host keeps serving what was handed out before the move; it no longer creates
    // anything new.
    "PUBLIC_ORIGIN": "https://passalong.dev",
    "ENVIRONMENT": "production",
    // Free tier: how many published/promoted guides one account may keep synced.
    // Local guides are unlimited; this only gates the hosted copy.
    "FREE_SYNC_LIMIT": "25",
    // Sender for handoff/invite mail. Must be on a domain onboarded to Email Service.
    "EMAIL_FROM": "no-reply@passalong.dev",
    // How the sender reads in an inbox list. Without it Gmail shows the local part, so every mail
    // arrived from "no-reply" — the one thing the sender cannot do, rather than who it is.
    "EMAIL_FROM_NAME": "Passalong"
  }
}
