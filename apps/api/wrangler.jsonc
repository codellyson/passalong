{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passalong-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Static files (stylesheet, icons, robots.txt, 404 page) are served straight from the edge,
  // before the Worker runs; anything not in public/ falls through to the Hono app. The binding
  // lets the app serve 404.html itself for unmatched routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },

  // Three hosts. `passalong.dev` is canonical. `www.passalong.dev` is routed only so it resolves —
  // the Worker redirects it to the apex (`canonicalRedirect` in src/hosts.ts) rather than serving
  // it, so it never becomes a second identity minting share links. `passalong.kreativekorna.com`
  // does serve, because share links were already handed out under it and their keys live in the
  // URL. Share links are built from the request host (`origin` in src/index.ts), so each serving
  // host stays internally consistent. Wrangler creates the DNS records on deploy.
  "routes": [
    { "pattern": "passalong.dev", "custom_domain": true },
    { "pattern": "www.passalong.dev", "custom_domain": true },
    { "pattern": "passalong.kreativekorna.com", "custom_domain": true }
  ],

  // Account creation is the only unauthenticated write. Per-IP throttle so a script cannot
  // fill the account table; `namespace_id` just has to be unique within this account.
  "ratelimits": [
    { "name": "ACCOUNT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Outbound mail (handoffs, pulls, invites) through Cloudflare Email Service. No API key: the
  // binding is the credential. EMAIL_FROM's domain must be onboarded to Email Service, and
  // sending to addresses outside the account needs the Workers Paid plan.
  "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passalong",
      // An identifier, not a secret: it names the database, not who may use it.
      "database_id": "1c3e3932-242d-4e7f-ae3e-09c598b6a5ca",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // Free tier: how many published/promoted guides one account may keep synced.
    // Local guides are unlimited; this only gates the hosted copy.
    "FREE_SYNC_LIMIT": "25",
    // Sender for handoff/invite mail. Must be on a domain onboarded to Email Service.
    "EMAIL_FROM": "no-reply@passalong.dev"
  }
}
