#!/usr/bin/env node
// Passalong CLI. Few flags on purpose: the defaults are the product.
//
//   passalong share [file]        publish a guide (newest draft, or a scaffold you edit) → id + link
//   passalong pull <id|link>      fetch a guide into ./.passalong/ and print it
//   passalong list [query]        your guides, local and synced
//   passalong open <id> [--print] view a guide in the browser (or the terminal)
//   passalong hub                 open your synced guides in the browser
//   passalong done <id>           mark consumed: implemented on the receiving side
//   passalong promote <id>        mark promoted: graduated into a reusable reference
//   passalong rm <id>             delete a guide locally and from sync
//   passalong export [dir]        dump every guide as plain markdown (default ./passalong-export)
//   passalong login [token]       create an account, or attach this machine to an existing one
//   passalong setup               install the Claude Code capture skill + register the MCP server
//   passalong mcp                 run the MCP server over stdio
import { execFileSync, spawnSync } from "node:child_process";
import { cpSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as api from "../src/api.js";
import { scaffold } from "../src/capture.js";
import { serialize } from "../src/guide.js";
import * as passalong from "../src/passalong.js";
import * as store from "../src/store.js";

const PKG = resolve(dirname(fileURLToPath(import.meta.url)), "..");

function flags(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith("--")) {
      const next = argv[i + 1];
      if (next === undefined || next.startsWith("-")) out[t.slice(2)] = true;
      else out[t.slice(2)] = argv[++i];
    } else out._.push(t);
  }
  return out;
}

function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

const tty = process.stdout.isTTY && process.stdin.isTTY;

function edit(path) {
  const editor = process.env.VISUAL || process.env.EDITOR || "vi";
  const r = spawnSync(editor, [path], { stdio: "inherit", shell: true });
  if (r.status !== 0) die(`${editor} exited with ${r.status}`);
}

function openInBrowser(url) {
  const cmd = process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  spawnSync(cmd, [url], { stdio: "ignore", shell: process.platform === "win32" });
}

function relDate(iso) {
  if (!iso) return "";
  const d = (Date.now() - new Date(iso).getTime()) / 864e5;
  if (d < 1) return "today";
  if (d < 30) return `${Math.floor(d)}d ago`;
  return iso.slice(0, 10);
}

const commands = {
  async share(f) {
    let path = f._[0];
    let fromDrafts = false;
    if (!path) {
      const [latest] = store.drafts();
      if (latest) {
        path = latest;
        fromDrafts = true;
        console.error(`using draft ${path}`);
      } else {
        path = store.draftPath(new Date().toISOString().replace(/[:.]/g, "-"));
        writeFileSync(path, scaffold());
        fromDrafts = true;
        if (!tty) die(`no draft to share; scaffolded ${path} — fill it in and run \`passalong share ${path}\``);
      }
    }
    if (!existsSync(path)) die(`no such file: ${path}`);
    if (tty && !f["no-edit"]) edit(path);
    const { guide, url, synced, path: saved } = await passalong.share(readFileSync(path, "utf8")).catch((e) => die(e.message));
    if (fromDrafts) store.removeDraft(path);
    console.log(guide.meta.id);
    console.error(`shared "${guide.meta.title}" → ${saved}`);
    if (synced) console.error(`link: ${url}`);
    else console.error("not synced (run `passalong login` to sync across machines)");
  },

  async pull(f) {
    const ref = f._[0] || die("usage: passalong pull <id|link>");
    const { markdown, path, from } = await passalong.pull(ref).catch((e) => die(e.message));
    process.stdout.write(markdown);
    console.error(`\npulled from ${from} → ${path}`);
  },

  async list(f) {
    const rows = await passalong.list(f._.join(" "));
    if (rows.warning) console.error(`warning: ${rows.warning}`);
    if (!rows.length) return console.error("no guides yet — run `passalong share` after your next finished piece of work");
    for (const r of rows) {
      const tags = r.tags?.length ? `  #${r.tags.join(" #")}` : "";
      console.log(`${r.id}  ${r.status.padEnd(9)} ${relDate(r.created).padEnd(10)} ${r.title}${tags}`);
    }
  },

  async open(f) {
    const id = f._[0] || die("usage: passalong open <id>");
    const { guide } = await passalong.resolve(id).catch((e) => die(e.message));
    if (guide.meta.url && tty && !f.print) {
      openInBrowser(guide.meta.url);
      console.error(guide.meta.url);
    } else {
      process.stdout.write(serialize(guide));
      if (guide.meta.url) console.error(`\nlink: ${guide.meta.url}`);
    }
  },

  async hub() {
    if (!api.loggedIn()) die("not logged in — run `passalong login` first (the hub shows synced guides)");
    // The token rides in the URL fragment: the browser never sends it to the server, and the
    // page moves it into localStorage and scrubs the address bar on load.
    const url = `${api.baseUrl()}/hub#token=${encodeURIComponent(api.token())}`;
    if (tty) {
      openInBrowser(url);
      console.error(`${api.baseUrl()}/hub`);
    } else console.log(url);
  },

  async done(f) {
    const id = f._[0] || die("usage: passalong done <id>");
    const g = await passalong.setStatus(id, "consumed").catch((e) => die(e.message));
    console.error(`${g.meta.id} marked consumed`);
  },

  async promote(f) {
    const id = f._[0] || die("usage: passalong promote <id>");
    const g = await passalong.setStatus(id, "promoted").catch((e) => die(e.message));
    console.error(`${g.meta.id} marked promoted`);
  },

  async rm(f) {
    const id = f._[0] || die("usage: passalong rm <id>");
    await passalong.remove(id).catch((e) => die(e.message));
    console.error(`${id} removed`);
  },

  async export(f) {
    const dir = resolve(f._[0] || "passalong-export");
    const paths = passalong.exportAll(dir);
    console.error(`exported ${paths.length} guide${paths.length === 1 ? "" : "s"} → ${dir}`);
  },

  async login(f) {
    const given = f._[0];
    if (given) {
      store.writeConfig({ token: given, api: api.baseUrl() });
      const who = await api.me().catch((e) => die(`token rejected: ${e.message}`));
      console.error(`logged in (account ${who.account}) — ${api.baseUrl()}`);
      return;
    }
    if (api.loggedIn() && !f.new) {
      const who = await api.me().catch(() => null);
      if (who) {
        console.error(`already logged in (account ${who.account}). Attach another machine with:`);
        console.error(`  passalong login ${api.token()}`);
        return;
      }
    }
    const { token, account } = await api.createAccount().catch((e) => die(e.message));
    store.writeConfig({ token, api: api.baseUrl() });
    console.error(`account ${account} created on ${api.baseUrl()}. Sync is on.`);
    console.error("Attach other machines with:");
    console.error(`  passalong login ${token}`);
    console.error("(the token is the account — keep it private)");
  },

  async setup() {
    const skillDir = join(homedir(), ".claude", "skills", "passalong-capture");
    mkdirSync(skillDir, { recursive: true });
    cpSync(join(PKG, "skill"), skillDir, { recursive: true });
    console.error(`installed Claude Code skill → ${skillDir}`);
    try {
      execFileSync("claude", ["mcp", "add", "--scope", "user", "passalong", "--", "passalong", "mcp"], { stdio: "pipe" });
      console.error("registered MCP server: claude mcp add passalong -- passalong mcp");
    } catch (err) {
      const msg = String(err.stderr || err.message);
      if (/already exists/i.test(msg)) console.error("MCP server already registered");
      else console.error(`could not register MCP server automatically (${msg.trim()}).\n  run: claude mcp add passalong -- passalong mcp`);
    }
    if (!api.loggedIn()) console.error("sync is off; run `passalong login` when you want guides to follow you across machines");
    console.error("done. In Claude Code, say \"pass this along\" at the end of a task, or run /passalong-capture.");
  },

  async mcp() {
    const { serve } = await import("../src/mcp.js");
    await serve();
  },

  async help() {
    const src = readFileSync(fileURLToPath(import.meta.url), "utf8");
    const lines = src.split("\n").filter((l) => l.startsWith("//   passalong "));
    console.log("passalong — hand finished work to another context\n");
    console.log(lines.map((l) => l.slice(3)).join("\n"));
  },
};

const argv = flags(process.argv.slice(2));
const cmd = argv._.shift() || "help";
if (cmd === "--help" || cmd === "-h" || !commands[cmd]) commands.help();
else await commands[cmd](argv).catch((e) => die(e.message));
