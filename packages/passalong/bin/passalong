#!/usr/bin/env node
// Passalong CLI. Few flags on purpose: the defaults are the product.
//
//   passalong share [file] [--to TARGET]  publish a guide → id + link
//     TARGET is a team, team/@handle for one person, or "team/#group" for the people who do a
//     thing — quote that one, since a shell may read the # as a comment
//   passalong task "<what needs doing>"  write a task for an agent; it waits in Draft
//   passalong ready <id...|--all> tasks you have read are ready — an agent may take them now
//   passalong tasks               every task and where it is: draft, ready, claimed, stalled, review
//   passalong work [--once] [--agent CMD]  run an agent on each ready task here, one after another
//   passalong approve <id>        the work in review is done
//   passalong reject <id> <why>   not done: back to Ready, and the next agent reads why
//   passalong release <id>        take a task back from the agent holding it, stalled or not
//   passalong attach <image>      upload evidence and print the markdown that points at it
//   passalong pull <id|link>      fetch a guide into ./.passalong/ and print it
//   passalong start <id|link>     pull it and take it — one command for "I am doing this"
//   passalong inbox               guides handed to you that you have not pulled yet
//   passalong board               waiting on you, in flight, landed, worth keeping
//   passalong activity [--all]    what happened while you were away; clears unless --all
//   passalong log [repo]          what you did, newest first, by month
//   passalong list [query]        your guides and your teams', local and synced
//   passalong open <id> [--print] view a guide in the browser (or the terminal)
//   passalong hub                 open your synced guides in the browser
//   passalong take <id>           you are doing it — said before the work, so the sender stops guessing
//   passalong pass <id> <why>     it is not yours — hands it back to its author with your reason
//   passalong works <id>          you tried it and it holds up
//   passalong broken <id> <why>   you tried it and it does not — the author is told, with your reason
//   passalong done <id>           archive it: off your board and out of the free tier's count
//   passalong rm <id>             delete a guide locally and from sync
//   passalong export [dir]        dump every guide as plain markdown (default ./passalong-export)
//   passalong login [token]       create an account, or attach this machine with a token from your hub
//   passalong me [--handle H] [--name N] [--email E]   who you are to teammates
//   passalong team                current team and its members
//   passalong team create <name>  start a team (you become its owner)
//   passalong team invite [email] make an invite link (mailed when an email is given)
//   passalong team join <link|code>  accept an invite
//   passalong team use <slug>     switch the current team
//   passalong setup               install the Claude Code capture skill + register the MCP server
//   passalong mcp                 run the MCP server over stdio
import { execFileSync, spawnSync } from "node:child_process";
import { cpSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as api from "../src/api.js";
import { scaffold, taskScaffold } from "../src/capture.js";
import { serialize } from "../src/guide.js";
import * as passalong from "../src/passalong.js";
import * as store from "../src/store.js";

const PKG = resolve(dirname(fileURLToPath(import.meta.url)), "..");

function flags(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith("--")) {
      const next = argv[i + 1];
      if (next === undefined || next.startsWith("-")) out[t.slice(2)] = true;
      else out[t.slice(2)] = argv[++i];
    } else out._.push(t);
  }
  return out;
}

function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

const tty = process.stdout.isTTY && process.stdin.isTTY;

function edit(path) {
  const editor = process.env.VISUAL || process.env.EDITOR || "vi";
  const r = spawnSync(editor, [path], { stdio: "inherit", shell: true });
  if (r.status !== 0) die(`${editor} exited with ${r.status}`);
}

function openInBrowser(url) {
  const cmd =
    process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  spawnSync(cmd, [url], { stdio: "ignore", shell: process.platform === "win32" });
}

function relDate(iso) {
  if (!iso) return "";
  const d = (Date.now() - new Date(iso).getTime()) / 864e5;
  if (d < 1 / 24) return "just now";
  if (d < 1) return `${Math.floor(d * 24)}h ago`;
  if (d < 30) return `${Math.floor(d)}d ago`;
  return iso.slice(0, 10);
}

function guideLine(r) {
  const who = r.team ? `  ${r.team}${r.to ? `/@${r.to}` : ""}${r.mine ? "" : ` from @${r.from || "?"}`}` : "";
  const tags = r.tags?.length ? `  #${r.tags.join(" #")}` : "";
  let pulled = "";
  if (r.mine && r.pulled_by?.length) {
    const p = r.pulled_by[0];
    pulled = `  ← ${p.handle ? `@${p.handle}` : "link"} ${relDate(p.at)}${r.pulled_by.length > 1 ? ` +${r.pulled_by.length - 1}` : ""}`;
  }
  return `${r.id}  ${r.status.padEnd(9)} ${relDate(r.created).padEnd(10)} ${r.title}${who}${tags}${pulled}`;
}

function activityLine(n) {
  const dot = n.read ? " " : "•";
  return `${dot} ${(n.guide || "").padEnd(8)}  ${relDate(n.at).padEnd(10)} ${n.text}`;
}

const MONTHS = "January February March April May June July August September October November December".split(" ");
/** "September 2026" from an ISO timestamp, without pulling in a date library for one heading. */
const monthOf = (iso) => `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;

const commands = {
  async share(f) {
    let path = f._[0];
    if (!path) {
      const [latest] = store.drafts();
      if (latest) {
        path = latest;
        console.error(`using draft ${path}`);
      } else {
        path = store.draftPath(new Date().toISOString().replace(/[:.]/g, "-"));
        writeFileSync(path, scaffold());
        if (!tty)
          die(`no draft to share; scaffolded ${path} — fill it in and run \`passalong share ${path}\``);
      }
    }
    if (!existsSync(path)) die(`no such file: ${path}`);
    if (tty && !f["no-edit"]) edit(path);
    const to = typeof f.to === "string" ? f.to : undefined;
    const { guide, url, synced, notified, path: saved } = await passalong
      .share(readFileSync(path, "utf8"), { to })
      .catch((e) => die(e.message));
    // Any draft that went out is spent, however it was named — a task that failed validation is
    // re-shared by its path, and leaving it would have the next bare `share` publish it again.
    // removeDraft() touches nothing outside the drafts directory.
    store.removeDraft(resolve(path));
    console.log(guide.meta.id);
    console.error(`shared "${guide.meta.title}" → ${saved}`);
    if (guide.meta.team)
      console.error(
        `handed to ${guide.meta.team}${guide.meta.to ? `/@${guide.meta.to}${notified ? " (emailed)" : " (in their inbox)"}` : " (team inbox)"}`,
      );
    if (synced) console.error(`link: ${url}`);
    else console.error("not synced (run `passalong login` to sync across machines)");
  },

  /**
   * Write a task. It lands in Draft and stays there until `passalong ready`: the gap between the
   * two is the one moment a person reads what an agent is about to be asked to do.
   */
  async task(f) {
    const sentence = f._.join(" ").trim() || die('usage: passalong task "<what needs doing>"');
    const path = store.draftPath(`task-${new Date().toISOString().replace(/[:.]/g, "-")}`);
    writeFileSync(path, taskScaffold(sentence));
    if (tty && !f["no-edit"]) edit(path);
    const { guide, synced } = await passalong
      .share(readFileSync(path, "utf8"))
      .catch((e) => die(`${e.message}\ndraft kept at ${path} — fix it and run \`passalong share ${path}\``));
    store.removeDraft(path);
    const id = guide.meta.id;
    console.log(id);
    const target = guide.meta.target_context;
    console.error(`task "${guide.meta.title}" is in Draft${target ? ` for ${target}` : " (no repo)"}`);
    console.error(`when an agent may take it: passalong ready ${id}`);
    if (!synced) console.error("not synced (run `passalong login` — agents elsewhere cannot see it)");
  },

  async tasks() {
    const rows = await passalong.tasks().catch((e) => die(e.message));
    if (!rows.length) return console.error('no tasks yet — write one with: passalong task "<what needs doing>"');
    for (const t of rows) {
      const c = t.claim;
      const who = c ? `  ${c.host || "?"}:${c.worktree.split("/").pop() || "?"}` : "";
      const said = c?.note ? `  "${c.note}"` : "";
      console.log(`${t.id}  ${t.state.padEnd(8)} ${t.title}${t.target ? `  [${t.target}]` : ""}${who}${said}`);
      // What came back, under the task it answers: the thing a reviewer reads before deciding.
      if (t.state === "review" && c?.report)
        console.log(`          → ${c.report}  ${c.report_title || "(untitled)"}${c.pr ? `  ${c.pr}` : ""}`);
    }
    if (rows.some((t) => t.state === "review"))
      console.error("\nread a write-up with: passalong open <id> — then approve or reject the task");
  },

  /**
   * Work the queue from this worktree until it is empty. The agent is `claude -p` unless --agent or
   * PASSALONG_AGENT says otherwise, e.g. "claude -p --permission-mode acceptEdits" so it can edit
   * files without asking — which is yours to decide, not this command's.
   */
  async work(f) {
    const run = await passalong
      .work({
        agent: typeof f.agent === "string" ? f.agent : undefined,
        once: Boolean(f.once),
        any: Boolean(f.any),
        onTask: (t) => console.error(`\n→ ${t.id}  ${t.title}${t.resumed ? "  (resuming)" : ""}`),
      })
      .catch((e) => die(e.message));
    for (const id of run.finished) console.log(id);
    const n = run.finished.length;
    const done = `${n} task${n === 1 ? "" : "s"} finished and waiting for review`;
    if (run.stopped === "unfinished")
      die(
        `${done}. Stopped: the agent exited with ${run.task} still ${run.state || "open"} — ` +
          `run again to resume it, or \`passalong release ${run.task}\``,
      );
    console.error(`${done}${run.stopped === "empty" ? " — nothing left for this repo" : ""}`);
    if (n) console.error("review them with: passalong tasks");
  },

  async approve(f) {
    const id = f._[0] || die("usage: passalong approve <id>");
    await passalong.approveTask(id).catch((e) => die(e.message));
    console.error(`${id} is done`);
  },

  async reject(f) {
    const id = f._[0] || die("usage: passalong reject <id> <why>");
    await passalong.rejectTask(id, f._.slice(1).join(" ")).catch((e) => die(e.message));
    console.error(`${id} is back in Ready — the next agent reads why`);
  },

  async release(f) {
    const id = f._[0] || die("usage: passalong release <id>");
    await passalong.releaseTask(id).catch((e) => die(e.message));
    console.error(`${id} is back in Ready — it says where the last agent left it`);
  },

  async ready(f) {
    if (f.all) {
      const ids = await passalong.readyDrafts().catch((e) => die(e.message));
      if (!ids.length) return console.error("no drafts of yours to make ready");
      for (const id of ids) console.log(id);
      return console.error(`${ids.length} task${ids.length === 1 ? "" : "s"} Ready — agents may take them`);
    }
    if (!f._.length) die("usage: passalong ready <id...> | --all");
    for (const id of f._) {
      const g = await passalong.ready(id).catch((e) => die(e.message));
      console.error(`${g.meta.id} is Ready — an agent may take it`);
    }
  },

  async pull(f) {
    const ref = f._[0] || die("usage: passalong pull <id|link>");
    const { markdown, path, from } = await passalong.pull(ref).catch((e) => die(e.message));
    process.stdout.write(markdown);
    console.error(`\npulled from ${from} → ${path}`);
  },

  /**
   * Pull and take in one command. `pull` says it arrived, `take` says somebody is doing it, and
   * they stay separate because reading a guide to decide it is not yours is what `pass` is for.
   * This is the pair for the case where you already know: you are picking this up.
   */
  async start(f) {
    const ref = f._[0] || die("usage: passalong start <id|link>");
    const r = await passalong.start(ref).catch((e) => die(e.message));
    process.stdout.write(r.markdown);
    console.error(`\npulled from ${r.from} → ${r.path}`);
    if (r.took) console.error("you are on it, and the author has been told");
    else if (r.own) console.error("your own guide — nothing to take");
    else if (r.ack_error) console.error(`not taken (${r.ack_error}) — run \`passalong take ${r.guide.meta.id}\``);
    // Saying nothing here would be the silence the whole hop exists to end: you would have the
    // guide, believe you had answered for it, and the sender would still be waiting.
    else console.error("not taken — sync is off, so nobody was told (run `passalong login`)");
  },

  /**
   * Upload an image and print the markdown that points at it. Evidence goes *in* the document:
   * a guide travels as markdown to whoever holds its link, so a file beside it does not travel.
   */
  async attach(f) {
    const file = f._[0] || die("usage: passalong attach <image> [--name LABEL]");
    const shot = await passalong.attach(file, { name: f.name || "" }).catch((e) => die(e.message));
    process.stdout.write(`${shot.markdown}\n`);
    console.error(`uploaded ${shot.bytes} bytes → ${shot.url}`);
  },

  async inbox() {
    const rows = await passalong.inbox().catch((e) => die(e.message));
    if (!rows.length) return console.error("inbox empty — nothing handed to you that you haven't pulled");
    for (const r of rows) console.log(guideLine(r));
    console.error(`\n${rows.length} waiting. Take one with: passalong start <id>`);
  },

  async board() {
    const b = await passalong.board().catch((e) => die(e.message));
    const queue = (title, note, rows, line) => {
      if (!rows.length) return;
      console.log(`\n${title} · ${rows.length}   ${note}`);
      for (const g of rows) console.log(`  ${g.id}  ${relDate(g.created).padEnd(10)} ${line(g)}`);
    };
    queue("Waiting on you", "handed to you, not pulled yet", b.waiting, (g) => `${g.title}  from @${g.from || "?"}`);
    queue("Not working", "someone tried it and it does not hold up", b.failing, (g) =>
      `${g.title}  ${g.verdict?.by ? `@${g.verdict.by}` : "someone"}: ${g.verdict?.note || "no reason given"}`);
    queue("In flight", "handed over, nobody has taken it", b.in_flight, (g) =>
      `${g.title}  to ${g.team}${g.to ? `/@${g.to}` : ""}${g.stale ? "  ← not picked up" : ""}`);
    queue("Landed", "someone else has it", b.landed, (g) => `${g.title}  ${g.pulls} pull${g.pulls === 1 ? "" : "s"}`);
    const total = b.waiting.length + b.failing.length + b.in_flight.length + b.landed.length;
    if (!total) console.error("nothing in flight — every transfer is closed");
    else if (b.unread) console.error(`\n${b.unread} new: passalong activity`);
  },

  /**
   * What you did, newest first, under a heading per month.
   *
   * The month headings are the whole point: every other list in this CLI is ordered by what needs
   * you — the board's queues, `list`'s state rank — and none of them can answer "what did I get
   * done in September". Time is the axis nothing else offers.
   *
   * A repo narrows it, positionally and without a flag, for the same reason `list` takes its query
   * that way: it is the one thing you are likely to say, and a flag would make you name it twice.
   */
  async log(f) {
    const repo = f._.join(" ");
    const rows = await passalong.log({ repo }).catch((e) => die(e.message));
    if (!rows.length)
      return console.error(
        repo
          ? `nothing passed along from anything matching "${repo}"`
          : "nothing yet — your log fills up as you share, pull and answer guides",
      );
    let month = "";
    for (const r of rows) {
      const m = monthOf(r.at);
      if (m !== month) {
        console.log(`\n${m}`);
        month = m;
      }
      console.log(`  ${r.guide}  ${r.at.slice(0, 10)}  ${r.text}${r.repo && !repo ? `  ${r.repo}` : ""}`);
    }
    // Said every time, because the list looks like a work log and is not one. A month you shipped
    // without sharing looks identical here to a month you did nothing.
    console.error(`\n${rows.length} thing${rows.length === 1 ? "" : "s"}. Work that never became a guide is not here.`);
  },

  async activity(f) {
    const { notifications, unread } = await passalong.activity({ all: f.all }).catch((e) => die(e.message));
    if (!notifications.length)
      return console.error(
        f.all ? "nothing has happened yet" : "nothing new — your guides and handoffs are quiet",
      );
    for (const n of notifications) console.log(activityLine(n));
    const waiting = notifications.filter((n) => n.kind === "handoff" && !n.read);
    if (waiting.length) console.error(`\nPull one with: passalong pull ${waiting[0].guide}`);
    // Reading the feed is what marks it read: an unread count you have to clear by hand is a
    // chore, and `--all` is there for when you want to look without clearing.
    if (!f.all && unread) await passalong.seen().catch(() => {});
  },

  async list(f) {
    const scope = typeof f.team === "string" ? f.team : f.mine ? "mine" : "";
    const rows = await passalong.list(f._.join(" "), { scope });
    if (rows.warning) console.error(`warning: ${rows.warning}`);
    if (!rows.length)
      return console.error(
        "no guides yet — run `passalong share` after your next finished piece of work",
      );
    for (const r of rows) console.log(guideLine(r));
  },

  async open(f) {
    const id = f._[0] || die("usage: passalong open <id>");
    const { guide } = await passalong.resolve(id).catch((e) => die(e.message));
    if (guide.meta.url && tty && !f.print) {
      openInBrowser(guide.meta.url);
      console.error(guide.meta.url);
    } else {
      process.stdout.write(serialize(guide));
      if (guide.meta.url) console.error(`\nlink: ${guide.meta.url}`);
    }
  },

  async hub() {
    if (!api.loggedIn())
      die("not logged in — run `passalong login` first (the hub shows synced guides)");
    // The token rides in the URL fragment: the browser never sends it to the server, and the
    // page moves it into localStorage and scrubs the address bar on load.
    const url = `${api.baseUrl()}/hub#token=${encodeURIComponent(api.token())}`;
    if (tty) {
      openInBrowser(url);
      console.error(`${api.baseUrl()}/hub`);
    } else console.log(url);
  },

  /**
   * The first word back, before any of the work.
   *
   * Between a handoff and a pull the sender had no signal at all: an unanswered guide looks
   * exactly like one nobody has noticed. These two are the hop the MCP tool and the hub already
   * had and a terminal did not.
   */
  async take(f) {
    const id = f._[0] || die("usage: passalong take <id>");
    const r = await passalong.ack(id, true).catch((e) => die(e.message));
    console.error(`${r.id} — you are on it, and the author has been told`);
  },

  async pass(f) {
    const id = f._[0] || die("usage: passalong pass <id> <why it is not yours>");
    const why = f._.slice(1).join(" ");
    // Required, and the reason is the whole point: "not me" without "why" leaves the sender where
    // the silence did, still guessing whether to re-address it, wait, or go and ask.
    if (!why) die("say why you are passing: passalong pass <id> <why it is not yours>");
    const r = await passalong.ack(id, false, why).catch((e) => die(e.message));
    console.error(`${r.id} handed back — the author has been told: "${r.note}"`);
  },

  async works(f) {
    const id = f._[0] || die("usage: passalong works <id>");
    const r = await passalong.verdict(id, true, f._.slice(1).join(" ")).catch((e) => die(e.message));
    console.error(`${r.id} verified — the author has been told`);
  },

  async broken(f) {
    const id = f._[0] || die("usage: passalong broken <id> <what happened>");
    const why = f._.slice(1).join(" ");
    if (!why) die("say what went wrong: passalong broken <id> <what happened>");
    const r = await passalong.verdict(id, false, why).catch((e) => die(e.message));
    console.error(`${r.id} reported as not working — the author has been told: "${r.note}"`);
  },

  /**
   * Archive a guide: off your board, and out of what the free tier counts.
   *
   * It was deprecated for meaning "I implemented it", which is the reader's judgement and belongs
   * to the verdict. As shelf space it has a job nothing else does — it is the only way under the
   * sync limit that does not delete the work, and the 402 says so by name.
   */
  async done(f) {
    const id = f._[0] || die("usage: passalong done <id>");
    const g = await passalong.setStatus(id, "consumed").catch((e) => die(e.message));
    console.error(`${g.meta.id} archived — off your board, and it no longer counts against sync`);
  },

  async rm(f) {
    const id = f._[0] || die("usage: passalong rm <id>");
    await passalong.remove(id).catch((e) => die(e.message));
    console.error(`${id} removed`);
  },

  async export(f) {
    const dir = resolve(f._[0] || "passalong-export");
    const paths = passalong.exportAll(dir);
    console.error(`exported ${paths.length} guide${paths.length === 1 ? "" : "s"} → ${dir}`);
  },

  async login(f) {
    const given = f._[0];
    if (given) {
      store.writeConfig({ token: given, api: api.baseUrl() });
      const who = await api.me().catch((e) => die(`token rejected: ${e.message}`));
      console.error(`logged in (account ${who.account}) — ${api.baseUrl()}`);
      return;
    }
    if (api.loggedIn() && !f.new) {
      const who = await api.me().catch(() => null);
      if (who) {
        console.error(`already logged in (account ${who.account}). Attach another machine with:`);
        console.error(`  passalong login ${api.token()}`);
        return;
      }
    }
    const { token, account } = await api.createAccount().catch((e) => die(e.message));
    store.writeConfig({ token, api: api.baseUrl() });
    console.error(`account ${account} created on ${api.baseUrl()}. Sync is on.`);
    console.error("Attach other machines with:");
    console.error(`  passalong login ${token}`);
    console.error("(keep it private — it is a credential, not a password)");
    console.error("Give teammates a name to address you by: passalong me --handle <you>");
    console.error(`Add an email and password so you can sign in and recover it: ${api.baseUrl()}/hub`);
  },

  async me(f) {
    const patch = {};
    for (const k of ["handle", "name", "email"]) if (typeof f[k] === "string") patch[k] = f[k];
    const who = Object.keys(patch).length
      ? await api.updateMe(patch).then(api.me).catch((e) => die(e.message))
      : await api.me().catch((e) => die(e.message));
    console.log(`account  ${who.account}`);
    console.log(`handle   ${who.handle ? `@${who.handle}` : "(none — set one: passalong me --handle <you>)"}`);
    if (who.name) console.log(`name     ${who.name}`);
    if (who.email) console.log(`email    ${who.email}`);
    // The server sends the state by name, because a number cannot tell "no ceiling" apart from
    // "may sync nothing" — both of which arrive as a falsy limit.
    const ceiling =
      who.sync === "free"
        ? ` (${who.limit} active on your plan)`
        : who.sync === "none"
          ? " (no plan — nothing is syncing)"
          : " (no limit on your plan)";
    console.log(`guides   ${who.guides} synced${ceiling}`);
    const current = store.readConfig().team;
    console.log(
      `teams    ${who.teams.length ? who.teams.map((t) => `${t.slug}${t.slug === current ? "*" : ""} (${t.role})`).join(", ") : "(none — passalong team create <name>)"}`,
    );
  },

  async team(f) {
    const [sub, ...rest] = f._;
    const cfg = store.readConfig();
    if (!sub) {
      if (!cfg.team) {
        const { teams } = await api.teams().catch((e) => die(e.message));
        if (!teams.length) return console.error("no team yet — passalong team create <name>");
        return console.error(`you are in ${teams.map((t) => t.slug).join(", ")}; pick one: passalong team use <slug>`);
      }
      const t = await api.team(cfg.team).catch((e) => die(e.message));
      console.log(`${t.name} (${t.slug}) — ${t.members.length} member${t.members.length === 1 ? "" : "s"}, ${t.guides} guide${t.guides === 1 ? "" : "s"}`);
      for (const m of t.members)
        console.log(`  ${m.handle ? `@${m.handle}` : "(no handle)"}${m.name ? `  ${m.name}` : ""}  ${m.role}  joined ${relDate(m.joined)}`);
      return;
    }
    if (sub === "create") {
      const name = rest.join(" ") || die("usage: passalong team create <name>");
      const t = await api.createTeam(name).catch((e) => die(e.message));
      store.writeConfig({ team: t.slug });
      console.error(`team ${t.name} created as "${t.slug}" — now current. Invite people: passalong team invite [email]`);
      return;
    }
    if (sub === "invite") {
      const slug = cfg.team || die("no current team — passalong team use <slug>");
      const inv = await api.invite(slug, rest[0] || "").catch((e) => die(e.message));
      console.log(inv.url);
      console.error(
        inv.email
          ? inv.mailed
            ? `emailed ${inv.email}`
            : `not emailed (mail is not configured on the server) — send ${inv.email} the link above`
          : "send this link; they run: passalong team join <link>",
      );
      return;
    }
    if (sub === "join") {
      const ref = rest[0] || die("usage: passalong team join <link|code>");
      const code = ref.includes("/") ? ref.split("/").filter(Boolean).pop() : ref;
      const r = await api.join(code).catch((e) => die(e.message));
      store.writeConfig({ team: r.slug });
      console.error(`${r.joined ? "joined" : "already in"} ${r.name} (${r.slug}) — now current`);
      const who = await api.me().catch(() => null);
      if (who && !who.handle) console.error("teammates address you by handle: passalong me --handle <you>");
      return;
    }
    if (sub === "use") {
      const slug = rest[0] || die("usage: passalong team use <slug>");
      await api.team(slug).catch((e) => die(e.message));
      store.writeConfig({ team: slug });
      console.error(`current team: ${slug}`);
      return;
    }
    die("usage: passalong team [create <name> | invite [email] | join <link> | use <slug>]");
  },

  async setup() {
    const skillDir = join(homedir(), ".claude", "skills", "passalong-capture");
    mkdirSync(skillDir, { recursive: true });
    cpSync(join(PKG, "skill"), skillDir, { recursive: true });
    console.error(`installed Claude Code skill → ${skillDir}`);
    try {
      execFileSync("claude", ["mcp", "add", "--scope", "user", "passalong", "--", "passalong", "mcp"], {
        stdio: "pipe",
      });
      console.error("registered MCP server: claude mcp add passalong -- passalong mcp");
    } catch (err) {
      const msg = String(err.stderr || err.message);
      if (/already exists/i.test(msg)) console.error("MCP server already registered");
      else
        console.error(
          `could not register MCP server automatically (${msg.trim()}).\n  run: claude mcp add passalong -- passalong mcp`,
        );
    }
    if (!api.loggedIn())
      console.error("sync is off; run `passalong login` when you want guides to follow you across machines");
    console.error('done. In Claude Code, say "pass this along" at the end of a task, or run /passalong-capture.');
  },

  async mcp() {
    const { serve } = await import("../src/mcp.js");
    await serve();
  },

  async help() {
    const src = readFileSync(fileURLToPath(import.meta.url), "utf8");
    const lines = src.split("\n").filter((l) => l.startsWith("//   passalong "));
    console.log("passalong — hand finished work to another context\n");
    console.log(lines.map((l) => l.slice(3)).join("\n"));
  },
};

const argv = flags(process.argv.slice(2));
const cmd = argv._.shift() || "help";
if (cmd === "--help" || cmd === "-h" || !commands[cmd]) commands.help();
else await commands[cmd](argv).catch((e) => die(e.message));
