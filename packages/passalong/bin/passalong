#!/usr/bin/env node
// Passalong CLI. Few flags on purpose: the defaults are the product.
//
//   passalong share [file] [--to TARGET] [--follows ID]  publish a guide → id + link; --follows adds it as context to guide ID
//     --follows ID publishes it as a follow-up: more context for guide ID, listed under it and
//     handed to whoever pulls or starts that guide
//     TARGET is a team, team/@handle for one person, or "team/#group" for the people who do a
//     thing — quote that one, since a shell may read the # as a comment
//   passalong task "<what needs doing>"  write a task for an agent; it waits in Draft
//   passalong ready <id...|--all> tasks you have read are ready — an agent may take them now
//   passalong tasks               every task and where it is: draft, ready, claimed, stalled, review
//   passalong work [--once] [--agent CMD]  run an agent on each ready task here, one after another
//   passalong approve <id>        the work in review is done
//   passalong reject <id> <why>   not done: back to Ready, and the next agent reads why
//   passalong release <id>        take work back from whoever holds it, of any kind
//   passalong attach <file>       upload a picture or a file and print the markdown that points at it
//   passalong reply <id> <text>   write to whoever holds it (--file PATH to attach); or leave a note
//   passalong pull <id|link>      fetch a guide into ./.passalong/ and print it
//   passalong start <id|link>     pull it and take it — one command for "I am doing this"
//   passalong inbox               guides handed to you that you have not pulled yet
//   passalong board               waiting on you, in flight, landed, worth keeping
//   passalong activity [--all]    what happened while you were away; clears unless --all
//   passalong log [repo]          what you did, newest first, by month
//   passalong list [query]        your guides and your teams', local and synced
//   passalong open <id> [--print] view a guide in the browser (or the terminal)
//   passalong hub                 open your synced guides in the browser
//   passalong take <id>           you are doing it — said before the work, so the sender stops guessing
//   passalong pass <id> <why>     it is not yours — hands it back to its author with your reason
//   passalong assign <id> <to>    give it to @handle, a #group, or "team" — yours, or assigned to you
//   passalong admin create <email>   make an account that runs Passalong (owner only)
//   passalong admin list          who runs it
//   passalong admin grant|revoke <@handle>   make an existing account an admin, or stop it being one
//   passalong gift <who> --until <date> [--why "..."] [--seats N]
//                                 give Solo to @handle, or Team to team/slug, until a date (operator only)
//   passalong gifts               what has been given away, and what is still running
//   passalong ungift <gift id>    take one back now
//   passalong works <id> <shot.png...>  you tried it and it holds up — with a screenshot of it working
//   passalong broken <id> <why>   you tried it and it does not — the author is told, with your reason
//   passalong archive <id>        off your board and out of the free tier's count (was `done`)
//   passalong rm <id>             delete a guide locally and from sync
//   passalong export [dir]        dump every guide as plain markdown (default ./passalong-export)
//   passalong login [token]       sign in from the browser, or attach this machine with a token
//   passalong me [--handle H] [--name N] [--email E]   who you are to teammates
//   passalong team                current team and its members
//   passalong team create <name>  start a team (you become its owner)
//   passalong team invite [email] make an invite link (mailed when an email is given)
//   passalong team join <link|code>  accept an invite
//   passalong team use <slug>     switch the current team
//   passalong setup               install the Claude Code capture skill, MCP server and hooks
//   passalong now                 what this worktree holds and what is waiting (the hooks call --hook)
//   passalong mcp                 run the MCP server over stdio
//   passalong version             print the installed version (also -v, --version)
import { execFileSync, spawn, spawnSync } from "node:child_process";
import { createHash, randomBytes } from "node:crypto";
import { cpSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir, hostname } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as api from "../src/api.js";
import { scaffold, taskScaffold } from "../src/capture.js";
import { serialize } from "../src/guide.js";
import * as passalong from "../src/passalong.js";
import * as store from "../src/store.js";

const PKG = resolve(dirname(fileURLToPath(import.meta.url)), "..");

function flags(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith("--")) {
      const next = argv[i + 1];
      const key = t.slice(2);
      const value = next === undefined || next.startsWith("-") ? true : argv[++i];
      // A flag given twice keeps both, so `--file a.pdf --file b.csv` is two files. Nothing else
      // repeats a flag, so nothing else sees an array.
      out[key] = key in out && value !== true ? [out[key], value].flat() : value;
    } else out._.push(t);
  }
  return out;
}

function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

const tty = process.stdout.isTTY && process.stdin.isTTY;

/**
 * One line typed at the terminal. `hidden` turns the echo off, so a password does not end up in a
 * screen share, a scrollback or somebody's terminal recording.
 *
 * Written against readline rather than a dependency because this package has none beyond the MCP
 * SDK and zod, and asking for a line of text is not where that changes.
 */
/** Open a page in the default browser, and say nothing if there is none to open. */
function openPage(url) {
  const [cmd, args] =
    process.platform === "darwin"
      ? ["open", [url]]
      : process.platform === "win32"
        ? ["cmd", ["/c", "start", "", url]]
        : ["xdg-open", [url]];
  try {
    spawn(cmd, args, { detached: true, stdio: "ignore" }).on("error", () => {}).unref();
  } catch {}
}

/**
 * Sign in by approving in the browser: show a code, wait, and be handed a token. No password is
 * typed here and no token is pasted between windows. Needs no terminal to ask on, so an agent can
 * run it and tell the person which page to open.
 */
async function browserLogin() {
  const verifier = randomBytes(32).toString("hex");
  const challenge = createHash("sha256").update(verifier).digest("hex");
  const start = await api.deviceStart(challenge, `${hostname()} cli`).catch((e) => die(e.message));
  console.error(`Open ${start.url}`);
  console.error(`and check the page shows the code ${start.code}, then press Approve.`);
  if (tty) openPage(start.url);
  console.error("Waiting for you to approve it here… (Ctrl-C to stop)");
  const until = Date.now() + start.expires_in * 1000;
  while (Date.now() < until) {
    await new Promise((r) => setTimeout(r, start.interval * 1000));
    const got = await api.devicePoll(start.id, verifier).catch((e) => die(e.message));
    if (!got) continue;
    store.writeConfig({ token: got.token, api: api.baseUrl() });
    console.error(`signed in (account ${got.account}) on ${api.baseUrl()}. Sync is on.`);
    console.error("Attach other machines with:");
    console.error(`  passalong login ${got.token}`);
    console.error("(keep it private — it is a credential, not a password)");
    console.error("Give teammates a name to address you by: passalong me --handle <you>");
    return;
  }
  die("nobody approved it in time. Run `passalong login` again.");
}

/** The old way, kept for anyone who asks for it with `--email`: an email and a password, typed here. */
async function passwordLogin(f) {
// An account you cannot sign in to is one that dies with this file. This used to mint one
  // silently and then suggest adding a password afterwards; it asks up front instead.
  if (!tty)
    die(
      "no terminal to ask on. Sign in at " +
        `${api.baseUrl()}/hub, then attach this machine with \`passalong login <token>\``,
    );

  const email = f.email || (await ask("Email: "));
  if (!email) die("an email is needed to sign in");
  const password = await ask("Password: ", { hidden: true });
  if (!password) die("a password is needed to sign in");

  const label = `${hostname()} cli`;
  let who = await api.signIn(email, password, { label }).catch((e) => e);
  if (who instanceof Error) {
    // 401 is "no such account, or the wrong password", said the same way on purpose so the API
    // does not confirm which addresses exist. The CLI has to ask rather than guess, because
    // creating an account for a mistyped address is worse than being told to try again.
    if (who.status !== 401) die(who.message);
    const yes = (await ask(`No account signed in as ${email}. Create one? [y/N] `)).toLowerCase();
    if (yes !== "y" && yes !== "yes")
      die("not signed in. If the password was wrong, try again, or reset it at " + `${api.baseUrl()}/hub`);
    const again = await ask("Choose a password: ", { hidden: true });
    if (again !== password) die("those did not match");
    who = await api.signIn(email, password, { make: true, label }).catch((e) => die(e.message));
  }

  store.writeConfig({ token: who.token, api: api.baseUrl() });
  console.error(`signed in as ${email} (account ${who.account}) on ${api.baseUrl()}. Sync is on.`);
  console.error("Attach other machines with:");
  console.error(`  passalong login ${who.token}`);
  console.error("(keep it private — it is a credential, not a password)");
  console.error("Give teammates a name to address you by: passalong me --handle <you>");
}

async function ask(question, { hidden = false } = {}) {
  const { createInterface } = await import("node:readline");
  const rl = createInterface({ input: process.stdin, output: process.stdout, terminal: true });
  if (hidden) {
    // readline still writes the prompt itself; everything after it is swallowed. The newline the
    // user's Return would have echoed is put back by hand, or the next line starts mid-prompt.
    rl.output.write(question);
    rl._writeToOutput = () => {};
  }
  try {
    // `close` as well as an answer: stdin reaching EOF part-way through — a pipe, a closed pty, a
    // ^D — never calls the question's callback, and without this the promise is simply never
    // settled and the process exits on a warning about it rather than saying what happened.
    const answer = await new Promise((done) => {
      rl.on("close", () => done(null));
      rl.question(hidden ? "" : question, done);
    });
    if (hidden) process.stdout.write("\n");
    if (answer === null) die("nothing to read from — sign in at the terminal, or pass a token");
    return answer.trim();
  } finally {
    rl.close();
  }
}

function edit(path) {
  const editor = process.env.VISUAL || process.env.EDITOR || "vi";
  const r = spawnSync(editor, [path], { stdio: "inherit", shell: true });
  if (r.status !== 0) die(`${editor} exited with ${r.status}`);
}

function openInBrowser(url) {
  const cmd =
    process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  spawnSync(cmd, [url], { stdio: "ignore", shell: process.platform === "win32" });
}

function relDate(iso) {
  if (!iso) return "";
  const d = (Date.now() - new Date(iso).getTime()) / 864e5;
  if (d < 1 / 24) return "just now";
  if (d < 1) return `${Math.floor(d * 24)}h ago`;
  if (d < 30) return `${Math.floor(d)}d ago`;
  return iso.slice(0, 10);
}

function guideLine(r) {
  const who = r.team ? `  ${r.team}${r.to ? `/@${r.to}` : ""}${r.mine ? "" : ` from @${r.from || "?"}`}` : "";
  const tags = r.tags?.length ? `  #${r.tags.join(" #")}` : "";
  let pulled = "";
  if (r.mine && r.pulled_by?.length) {
    const p = r.pulled_by[0];
    pulled = `  ← ${p.handle ? `@${p.handle}` : "link"} ${relDate(p.at)}${r.pulled_by.length > 1 ? ` +${r.pulled_by.length - 1}` : ""}`;
  }
  return `${r.id}  ${r.status.padEnd(9)} ${relDate(r.created).padEnd(10)} ${r.title}${who}${tags}${pulled}`;
}

function activityLine(n) {
  const dot = n.read ? " " : "•";
  return `${dot} ${(n.guide || "").padEnd(8)}  ${relDate(n.at).padEnd(10)} ${n.text}`;
}

/**
 * After a pulled guide, the follow-ups written for it: more context, each its own guide. Listed on
 * stderr rather than printed in full, so stdout stays exactly the document; nothing at all when
 * there are none or sync is off.
 */
async function listFollowUps(meta) {
  const guides = await passalong.followUpGuides(meta);
  if (!guides.length) return;
  console.error(
    `\n${guides.length} follow-up${guides.length === 1 ? "" : "s"} — more context for this guide:`,
  );
  for (const g of guides) console.error(`  ${g.id}  ${g.title || "untitled"}`);
  console.error("Read one with: passalong pull <id>");
}

const MONTHS = "January February March April May June July August September October November December".split(" ");
/** "September 2026" from an ISO timestamp, without pulling in a date library for one heading. */
const monthOf = (iso) => `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;

// ---- the status line cache --------------------------------------------------------------------------

/** One small file per working directory, so two sessions in two repos each see their own. */
const statusPath = (cwd) =>
  join(store.HOME, "statusline", `${createHash("sha1").update(cwd).digest("hex").slice(0, 16)}.json`);

function writeStatus(cwd, text) {
  const p = statusPath(cwd);
  mkdirSync(dirname(p), { recursive: true });
  writeFileSync(p, JSON.stringify({ at: Date.now(), text }));
}

/** How old a cached line may be before a refresh is started behind it. */
const STATUS_TTL_MS = 30_000;

/**
 * Print the cached line for this directory at once, and when it is stale start a detached refresh
 * that writes the next one. The first run in a directory prints a placeholder; the refresh lands
 * within a second or two, and the next update shows it. Offline or signed out, it says nothing.
 */
async function statusLine() {
  let input = {};
  if (!process.stdin.isTTY) {
    let raw = "";
    for await (const chunk of process.stdin) raw += chunk;
    try {
      input = JSON.parse(raw || "{}");
    } catch {}
  }
  if (!api.loggedIn()) return;
  const cwd = input.workspace?.current_dir || input.cwd || process.cwd();
  let cached = null;
  try {
    cached = JSON.parse(readFileSync(statusPath(cwd), "utf8"));
  } catch {}
  process.stdout.write(cached?.text ?? "passalong");
  if (!cached || Date.now() - cached.at > STATUS_TTL_MS) {
    // Marked fresh before the refresh starts, so a burst of updates starts one refresh, not ten.
    writeStatus(cwd, cached?.text ?? "passalong");
    spawn(process.execPath, [fileURLToPath(import.meta.url), "now", "--statusline-refresh", cwd], {
      detached: true,
      stdio: "ignore",
      env: process.env,
    }).unref();
  }
}

const commands = {
  async share(f) {
    let path = f._[0];
    if (!path) {
      const [latest] = store.drafts();
      if (latest) {
        path = latest;
        console.error(`using draft ${path}`);
      } else {
        path = store.draftPath(new Date().toISOString().replace(/[:.]/g, "-"));
        writeFileSync(path, scaffold());
        if (!tty)
          die(`no draft to share; scaffolded ${path} — fill it in and run \`passalong share ${path}\``);
      }
    }
    if (!existsSync(path)) die(`no such file: ${path}`);
    if (tty && !f["no-edit"]) edit(path);
    const to = typeof f.to === "string" ? f.to : undefined;
    const follows = typeof f.follows === "string" ? f.follows : undefined;
    const { guide, url, synced, notified, path: saved } = await passalong
      .share(readFileSync(path, "utf8"), { to, follows })
      .catch((e) => die(e.message));
    // Any draft that went out is spent, however it was named — a task that failed validation is
    // re-shared by its path, and leaving it would have the next bare `share` publish it again.
    // removeDraft() touches nothing outside the drafts directory.
    store.removeDraft(resolve(path));
    console.log(guide.meta.id);
    console.error(`shared "${guide.meta.title}" → ${saved}`);
    if (guide.meta.parent) console.error(`follows ${guide.meta.parent}`);
    if (guide.meta.team)
      console.error(
        `handed to ${guide.meta.team}${guide.meta.to ? `/@${guide.meta.to}${notified ? " (emailed)" : " (in their inbox)"}` : " (team inbox)"}`,
      );
    if (synced) console.error(`link: ${url}`);
    else console.error("not synced (run `passalong login` to sync across machines)");
  },

  /**
   * Write a task. It lands in Draft and stays there until `passalong ready`: the gap between the
   * two is the one moment a person reads what an agent is about to be asked to do.
   */
  async task(f) {
    const sentence = f._.join(" ").trim() || die('usage: passalong task "<what needs doing>"');
    const path = store.draftPath(`task-${new Date().toISOString().replace(/[:.]/g, "-")}`);
    writeFileSync(path, taskScaffold(sentence));
    if (tty && !f["no-edit"]) edit(path);
    const { guide, synced } = await passalong
      .share(readFileSync(path, "utf8"))
      .catch((e) => die(`${e.message}\ndraft kept at ${path} — fix it and run \`passalong share ${path}\``));
    store.removeDraft(path);
    const id = guide.meta.id;
    console.log(id);
    const target = guide.meta.target_context;
    console.error(`task "${guide.meta.title}" is in Draft${target ? ` for ${target}` : " (no repo)"}`);
    console.error(`when an agent may take it: passalong ready ${id}`);
    if (!synced) console.error("not synced (run `passalong login` — agents elsewhere cannot see it)");
  },

  async tasks() {
    const rows = await passalong.tasks().catch((e) => die(e.message));
    if (!rows.length) return console.error('no tasks yet — write one with: passalong task "<what needs doing>"');
    for (const t of rows) {
      const c = t.claim;
      const who = c ? `  ${c.host || "?"}:${c.worktree.split("/").pop() || "?"}` : "";
      const said = c?.note ? `  "${c.note}"` : "";
      console.log(`${t.id}  ${t.state.padEnd(8)} ${t.title}${t.target ? `  [${t.target}]` : ""}${who}${said}`);
      // What came back, under the task it answers: the thing a reviewer reads before deciding.
      if (t.state === "review" && c?.report)
        console.log(`          → ${c.report}  ${c.report_title || "(untitled)"}${c.pr ? `  ${c.pr}` : ""}`);
    }
    if (rows.some((t) => t.state === "review"))
      console.error("\nread a write-up with: passalong open <id> — then approve or reject the task");
  },

  /**
   * Work the queue from this worktree until it is empty. The agent is `claude -p` unless --agent or
   * PASSALONG_AGENT says otherwise, e.g. "claude -p --permission-mode acceptEdits" so it can edit
   * files without asking — which is yours to decide, not this command's.
   */
  async work(f) {
    const run = await passalong
      .work({
        agent: typeof f.agent === "string" ? f.agent : undefined,
        once: Boolean(f.once),
        any: Boolean(f.any),
        onTask: (t) => console.error(`\n→ ${t.id}  ${t.title}${t.resumed ? "  (resuming)" : ""}`),
      })
      .catch((e) => die(e.message));
    for (const id of run.finished) console.log(id);
    const n = run.finished.length;
    const done = `${n} task${n === 1 ? "" : "s"} finished and waiting for review`;
    if (run.stopped === "unfinished")
      die(
        `${done}. Stopped: the agent exited with ${run.task} still ${run.state || "open"} — ` +
          `run again to resume it, or \`passalong release ${run.task}\``,
      );
    console.error(`${done}${run.stopped === "empty" ? " — nothing left for this repo" : ""}`);
    if (n) console.error("review them with: passalong tasks");
  },

  async approve(f) {
    const id = f._[0] || die("usage: passalong approve <id>");
    await passalong.approveTask(id).catch((e) => die(e.message));
    console.error(`${id} is done`);
  },

  async reject(f) {
    const id = f._[0] || die("usage: passalong reject <id> <why>");
    await passalong.rejectTask(id, f._.slice(1).join(" ")).catch((e) => die(e.message));
    console.error(`${id} is back in Ready — the next agent reads why`);
  },

  async release(f) {
    const id = f._[0] || die("usage: passalong release <id>");
    const r = await passalong.release(id).catch((e) => die(e.message));
    const from = Number(r?.from) || 1;
    console.error(
      `${id} is back in Ready${from > 1 ? `, taken back from ${from} places` : ""}` +
        " — whoever had it has been told",
    );
  },

  async ready(f) {
    if (f.all) {
      const ids = await passalong.readyDrafts().catch((e) => die(e.message));
      if (!ids.length) return console.error("no drafts of yours to make ready");
      for (const id of ids) console.log(id);
      return console.error(`${ids.length} task${ids.length === 1 ? "" : "s"} Ready — agents may take them`);
    }
    if (!f._.length) die("usage: passalong ready <id...> | --all");
    for (const id of f._) {
      const g = await passalong.ready(id).catch((e) => die(e.message));
      console.error(`${g.meta.id} is Ready — an agent may take it`);
    }
  },

  async pull(f) {
    const ref = f._[0] || die("usage: passalong pull <id|link>");
    const { guide, markdown, path, from } = await passalong.pull(ref).catch((e) => die(e.message));
    process.stdout.write(markdown);
    console.error(`\npulled from ${from} → ${path}`);
    await listFollowUps(guide.meta);
  },

  /**
   * Pull and take in one command. `pull` says it arrived, `take` says somebody is doing it, and
   * they stay separate because reading a guide to decide it is not yours is what `pass` is for.
   * This is the pair for the case where you already know: you are picking this up.
   */
  async start(f) {
    const ref = f._[0] || die("usage: passalong start <id|link>");
    const r = await passalong.start(ref).catch((e) => die(e.message));
    process.stdout.write(r.markdown);
    console.error(`\npulled from ${r.from} → ${r.path}`);
    if (r.took) console.error("you are on it, and the author has been told");
    else if (r.own) console.error("your own guide — nothing to take");
    else if (r.ack_error) console.error(`not taken (${r.ack_error}) — run \`passalong take ${r.guide.meta.id}\``);
    // Saying nothing here would be the silence the whole hop exists to end: you would have the
    // guide, believe you had answered for it, and the sender would still be waiting.
    else console.error("not taken — sync is off, so nobody was told (run `passalong login`)");
    await listFollowUps(r.guide.meta);
  },

  /**
   * Upload an image and print the markdown that points at it. Evidence goes *in* the document:
   * a guide travels as markdown to whoever holds its link, so a file beside it does not travel.
   */
  async attach(f) {
    const file = f._[0] || die("usage: passalong attach <file> [--name LABEL]");
    // A picture is evidence a page draws; anything else is a file somebody downloads.
    const isImage = Object.keys(passalong.SHOT_TYPES).some((x) => file.toLowerCase().endsWith(x));
    const shot = await (isImage ? passalong.attach : passalong.attachFile)(file, {
      name: f.name || "",
    }).catch((e) => die(e.message));
    process.stdout.write(`${shot.markdown}\n`);
    console.error(`uploaded ${shot.bytes} bytes → ${shot.url}`);
  },

  /**
   * Write to whoever holds a guide, or leave a note on one nobody holds yet. The person's side of
   * `ask`: an agent that stopped to wait hears this when it takes the guide again.
   */
  async reply(f) {
    const id = f._[0] || die("usage: passalong reply <id> <message> [--file PATH ...]");
    const files = [f.file].flat().filter((x) => typeof x === "string");
    const said = f._.slice(1).join(" ");
    if (!said && !files.length) die("say something, or attach a file: passalong reply <id> <message>");
    const r = await passalong.reply(id, said, { files }).catch((e) => die(e.message));
    console.error(
      r?.noted
        ? `${id} — nobody holds it yet, so this is a note: whoever takes it is handed it first`
        : `${id} — sent. Whoever holds it reads it the next time it checks in`,
    );
  },

  async inbox() {
    const rows = await passalong.inbox().catch((e) => die(e.message));
    if (!rows.length) return console.error("inbox empty — nothing handed to you that you haven't pulled");
    for (const r of rows) console.log(guideLine(r));
    console.error(`\n${rows.length} waiting. Take one with: passalong start <id>`);
  },

  async board() {
    const b = await passalong.board().catch((e) => die(e.message));
    const queue = (title, note, rows, line) => {
      if (!rows.length) return;
      console.log(`\n${title} · ${rows.length}   ${note}`);
      for (const g of rows) console.log(`  ${g.id}  ${relDate(g.created).padEnd(10)} ${line(g)}`);
    };
    queue("Waiting on you", "handed to you, not pulled yet", b.waiting, (g) => `${g.title}  from @${g.from || "?"}`);
    queue("Not working", "someone tried it and it does not hold up", b.failing, (g) =>
      `${g.title}  ${g.verdict?.by ? `@${g.verdict.by}` : "someone"}: ${g.verdict?.note || "no reason given"}`);
    queue("In flight", "handed over, nobody has taken it", b.in_flight, (g) =>
      `${g.title}  to ${g.team}${g.to ? `/@${g.to}` : ""}${g.stale ? "  ← not picked up" : ""}`);
    queue("Landed", "someone else has it", b.landed, (g) => `${g.title}  ${g.pulls} pull${g.pulls === 1 ? "" : "s"}`);
    const total = b.waiting.length + b.failing.length + b.in_flight.length + b.landed.length;
    if (!total) console.error("nothing in flight — every transfer is closed");
    else if (b.unread) console.error(`\n${b.unread} new: passalong activity`);
  },

  /**
   * What you did, newest first, under a heading per month.
   *
   * The month headings are the whole point: every other list in this CLI is ordered by what needs
   * you — the board's queues, `list`'s state rank — and none of them can answer "what did I get
   * done in September". Time is the axis nothing else offers.
   *
   * A repo narrows it, positionally and without a flag, for the same reason `list` takes its query
   * that way: it is the one thing you are likely to say, and a flag would make you name it twice.
   */
  async log(f) {
    const repo = f._.join(" ");
    const rows = await passalong.log({ repo }).catch((e) => die(e.message));
    if (!rows.length)
      return console.error(
        repo
          ? `nothing passed along from anything matching "${repo}"`
          : "nothing yet — your log fills up as you share, pull and answer guides",
      );
    let month = "";
    for (const r of rows) {
      const m = monthOf(r.at);
      if (m !== month) {
        console.log(`\n${m}`);
        month = m;
      }
      console.log(`  ${r.guide}  ${r.at.slice(0, 10)}  ${r.text}${r.repo && !repo ? `  ${r.repo}` : ""}`);
    }
    // Said every time, because the list looks like a work log and is not one. A month you shipped
    // without sharing looks identical here to a month you did nothing.
    console.error(`\n${rows.length} thing${rows.length === 1 ? "" : "s"}. Work that never became a guide is not here.`);
  },

  async activity(f) {
    const { notifications, unread } = await passalong.activity({ all: f.all }).catch((e) => die(e.message));
    if (!notifications.length)
      return console.error(
        f.all ? "nothing has happened yet" : "nothing new — your guides and handoffs are quiet",
      );
    for (const n of notifications) console.log(activityLine(n));
    const waiting = notifications.filter((n) => n.kind === "handoff" && !n.read);
    if (waiting.length) console.error(`\nPull one with: passalong pull ${waiting[0].guide}`);
    // Reading the feed is what marks it read: an unread count you have to clear by hand is a
    // chore, and `--all` is there for when you want to look without clearing.
    if (!f.all && unread) await passalong.seen().catch(() => {});
  },

  async list(f) {
    const scope = typeof f.team === "string" ? f.team : f.mine ? "mine" : "";
    const rows = await passalong.list(f._.join(" "), { scope });
    if (rows.warning) console.error(`warning: ${rows.warning}`);
    if (!rows.length)
      return console.error(
        "no guides yet — run `passalong share` after your next finished piece of work",
      );
    for (const r of rows) console.log(guideLine(r));
  },

  async open(f) {
    const id = f._[0] || die("usage: passalong open <id>");
    const { guide } = await passalong.resolve(id).catch((e) => die(e.message));
    if (guide.meta.url && tty && !f.print) {
      openInBrowser(guide.meta.url);
      console.error(guide.meta.url);
    } else {
      process.stdout.write(serialize(guide));
      if (guide.meta.url) console.error(`\nlink: ${guide.meta.url}`);
    }
  },

  async hub() {
    if (!api.loggedIn())
      die("not logged in — run `passalong login` first (the hub shows synced guides)");
    // The token rides in the URL fragment: the browser never sends it to the server, and the
    // page moves it into localStorage and scrubs the address bar on load.
    const url = `${api.baseUrl()}/hub#token=${encodeURIComponent(api.token())}`;
    if (tty) {
      openInBrowser(url);
      console.error(`${api.baseUrl()}/hub`);
    } else console.log(url);
  },

  /**
   * The first word back, before any of the work.
   *
   * Between a handoff and a pull the sender had no signal at all: an unanswered guide looks
   * exactly like one nobody has noticed. These two are the hop the MCP tool and the hub already
   * had and a terminal did not.
   */
  async take(f) {
    const id = f._[0] || die("usage: passalong take <id>");
    const r = await passalong.ack(id, true).catch((e) => die(e.message));
    console.error(`${r.id} — you are on it, and the author has been told`);
  },

  async pass(f) {
    const id = f._[0] || die("usage: passalong pass <id> <why it is not yours>");
    const why = f._.slice(1).join(" ");
    // Required, and the reason is the whole point: "not me" without "why" leaves the sender where
    // the silence did, still guessing whether to re-address it, wait, or go and ask.
    if (!why) die("say why you are passing: passalong pass <id> <why it is not yours>");
    const r = await passalong.ack(id, false, why).catch((e) => die(e.message));
    console.error(`${r.id} handed back — the author has been told: "${r.note}"`);
  },

  async assign(f) {
    const id = f._[0] || die('usage: passalong assign <id> <@handle | #group | team>');
    const to = f._[1] || die('say who: @handle for one person, #group, or "team" for everyone');
    const r = await passalong.assign(id, to).catch((e) => die(e.message));
    const back = r.taken_back ? ` — taken back from ${r.taken_back} who had it, and they were told` : "";
    console.error(`${r.id} is now for ${r.to || "everyone in the team"}${back}`);
  },

  // ---- who runs the product ---------------------------------------------------------------
  // `passalong admin <create|list|grant|revoke>`. An admin signs in like anybody else: the role is
  // a column, so there is no admin password and no admin token — only an account that has it.
  // "admin" is the word everywhere a person reads; `super` stays the stored value.

  async admin(f) {
    const what = f._[0] || "list";
    if (what === "create") {
      const email = f._[1] || die("usage: passalong admin create <email>");
      const r = await api.makeAdmin(email).catch((e) => die(e.message));
      // Shown once, and only here. The link is a day long because it is handed to somebody
      // rather than clicked on the spot.
      // Three labelled values on stdout, so one can be cut out with awk. "password link", not
      // "password": the value is a URL, and somebody will try to paste it into a password field.
      console.log(`account        ${r.account}`);
      console.log(`token          ${r.token}`);
      console.log(`password link  ${r.password_url}`);
      console.error(
        `\n${r.email} is an admin. The token is for \`passalong login\`, the link sets their ` +
          `password for the hub, and it expires ${r.expires.slice(0, 10)}. Neither is shown again.`,
      );
      return;
    }
    if (what === "grant" || what === "revoke") {
      const who = f._[1] || die(`usage: passalong admin ${what} <@handle | account id>`);
      const call = what === "grant" ? api.grantAdmin : api.revokeAdmin;
      const r = await call(who).catch((e) => die(e.message));
      console.error(
        what === "grant" ? `${r.name} is now an admin` : `${r.name} is no longer an admin`,
      );
      return;
    }
    if (what !== "list") die("usage: passalong admin <create <email> | list | grant | revoke>");
    const { supers = [] } = await api.listAdmins().catch((e) => die(e.message));
    if (!supers.length) return console.error("nobody is an admin yet");
    for (const s of supers)
      console.log(`${s.id}  ${s.name}${s.email ? `  ${s.email}` : ""}  since ${s.since.slice(0, 10)}`);
  },

  // ---- giving a plan away -----------------------------------------------------------------
  // Only for whoever the deployment names in ADMIN_ACCOUNTS; for everybody else the routes behind
  // these are 404, and the message says so rather than pretending the command does not exist.

  async gift(f) {
    const to = f._[0] || die('usage: passalong gift <@handle | team/slug> --until 2027-09-23 [--why "..."]');
    const until = f.until || die("say when it ends: --until 2027-09-23. A gift with no end is a price change");
    const r = await api
      .giveGift({ to, until, why: f.why || "", seats: Number(f.seats || 0) })
      .catch((e) => die(e.message));
    // The seat count is said back whether or not it was asked for: left off, it is the number of
    // members the team has today, and an operator should read which number that turned out to be.
    const seats = r.kind === "team" ? ` for ${r.seats} seat${r.seats === 1 ? "" : "s"}` : "";
    console.error(`${r.to} is on ${r.plan}${seats} until ${r.until.slice(0, 10)} — gift ${r.id}`);
  },

  async gifts() {
    const { gifts = [] } = await api.listGifts().catch((e) => die(e.message));
    if (!gifts.length) return console.error("no plans given away yet");
    for (const g of gifts) {
      const state = g.live ? `until ${g.until.slice(0, 10)}` : "over";
      console.log(
        `${g.id}  ${g.plan.padEnd(5)} ${state.padEnd(16)} ${g.to}${g.why ? ` — ${g.why}` : ""}`,
      );
    }
  },

  async ungift(f) {
    const id = f._[0] || die("usage: passalong ungift <gift id>  (passalong gifts lists them)");
    await api.takeGiftBack(id).catch((e) => die(e.message));
    console.error(`${id} taken back — that plan is lapsed as of now`);
  },

  async works(f) {
    const id = f._[0] || die("usage: passalong works <id> <screenshot.png...> [what you checked]");
    const { images, note } = passalong.proofArgs(f._.slice(1));
    const r = await passalong.verdict(id, true, note, { images }).catch((e) => die(e.message));
    console.error(
      `${r.id} verified with ${images.length || "your"} screenshot${images.length === 1 ? "" : "s"} — the author has been told`,
    );
  },

  async broken(f) {
    const id = f._[0] || die("usage: passalong broken <id> <what happened>");
    const why = f._.slice(1).join(" ");
    if (!why) die("say what went wrong: passalong broken <id> <what happened>");
    const r = await passalong.verdict(id, false, why).catch((e) => die(e.message));
    console.error(`${r.id} reported as not working — the author has been told: "${r.note}"`);
  },

  /**
   * Archive a guide: off your board, and out of what the free tier counts.
   *
   * The command was `done`, and the status it sets is still `consumed`, because both once meant "I
   * implemented it". That meaning went to the verdict, where it belongs — it is the reader's
   * judgement, not the author's — and what was left is shelf space, which has a job nothing else
   * does: the only way under the sync limit that does not delete the work, and the 402 says so by
   * name. So the command says what it does now.
   *
   * `consumed` stays on disk. It is a status inside markdown files in other people's
   * repositories, and `validate()` refuses a status it does not know, so renaming the value would
   * make a guide shared a month ago fail to re-share today. The word people read and the token the
   * format stores are allowed to differ; what is not allowed is two words for people.
   */
  async archive(f) {
    const id = f._[0] || die("usage: passalong archive <id>");
    const g = await passalong.setStatus(id, "consumed").catch((e) => die(e.message));
    console.error(`${g.meta.id} archived — off your board, and it no longer counts against sync`);
  },

  /** What `archive` was called. Kept so a script written against it still runs, and says so. */
  async done(f) {
    console.error("`passalong done` is now `passalong archive` — it archives, it does not mark work done.");
    return commands.archive(f);
  },

  async rm(f) {
    const id = f._[0] || die("usage: passalong rm <id>");
    await passalong.remove(id).catch((e) => die(e.message));
    console.error(`${id} removed`);
  },

  async export(f) {
    const dir = resolve(f._[0] || "passalong-export");
    const paths = passalong.exportAll(dir);
    console.error(`exported ${paths.length} guide${paths.length === 1 ? "" : "s"} → ${dir}`);
  },

  async login(f) {
    const given = f._[0];
    if (given) {
      store.writeConfig({ token: given, api: api.baseUrl() });
      const who = await api.me().catch((e) => die(`token rejected: ${e.message}`));
      console.error(`logged in (account ${who.account}) — ${api.baseUrl()}`);
      return;
    }
    if (api.loggedIn() && !f.new) {
      const who = await api.me().catch(() => null);
      if (who) {
        console.error(`already logged in (account ${who.account}). Attach another machine with:`);
        console.error(`  passalong login ${api.token()}`);
        return;
      }
    }
    // Passwords are for someone who asks: `--email` keeps the prompts. Everyone else is sent to the
    // browser, which works with no terminal at all — an agent can start it, and the person it is
    // working for clicks once.
    if (f.email || f.password) return passwordLogin(f);
    return browserLogin();
  },

  async me(f) {
    const patch = {};
    for (const k of ["handle", "name", "email"]) if (typeof f[k] === "string") patch[k] = f[k];
    const who = Object.keys(patch).length
      ? await api.updateMe(patch).then(api.me).catch((e) => die(e.message))
      : await api.me().catch((e) => die(e.message));
    console.log(`account  ${who.account}`);
    console.log(`handle   ${who.handle ? `@${who.handle}` : "(none — set one: passalong me --handle <you>)"}`);
    if (who.name) console.log(`name     ${who.name}`);
    if (who.email) console.log(`email    ${who.email}`);
    // The server sends the state by name, because a number cannot tell "no ceiling" apart from
    // "may sync nothing" — both of which arrive as a falsy limit.
    const ceiling =
      who.sync === "free"
        ? ` (${who.limit} active on your plan)`
        : who.sync === "none"
          ? " (no plan — nothing is syncing)"
          : " (no limit on your plan)";
    console.log(`guides   ${who.guides} synced${ceiling}`);
    const current = store.readConfig().team;
    console.log(
      `teams    ${who.teams.length ? who.teams.map((t) => `${t.slug}${t.slug === current ? "*" : ""} (${t.role})`).join(", ") : "(none — passalong team create <name>)"}`,
    );
  },

  async team(f) {
    const [sub, ...rest] = f._;
    const cfg = store.readConfig();
    if (!sub) {
      if (!cfg.team) {
        const { teams } = await api.teams().catch((e) => die(e.message));
        if (!teams.length) return console.error("no team yet — passalong team create <name>");
        return console.error(`you are in ${teams.map((t) => t.slug).join(", ")}; pick one: passalong team use <slug>`);
      }
      const t = await api.team(cfg.team).catch((e) => die(e.message));
      console.log(`${t.name} (${t.slug}) — ${t.members.length} member${t.members.length === 1 ? "" : "s"}, ${t.guides} guide${t.guides === 1 ? "" : "s"}`);
      for (const m of t.members)
        console.log(`  ${m.handle ? `@${m.handle}` : "(no handle)"}${m.name ? `  ${m.name}` : ""}  ${m.role}  joined ${relDate(m.joined)}`);
      return;
    }
    if (sub === "create") {
      const name = rest.join(" ") || die("usage: passalong team create <name>");
      const t = await api.createTeam(name).catch((e) => die(e.message));
      store.writeConfig({ team: t.slug });
      console.error(`team ${t.name} created as "${t.slug}" — now current. Invite people: passalong team invite [email]`);
      return;
    }
    if (sub === "invite") {
      const slug = cfg.team || die("no current team — passalong team use <slug>");
      const inv = await api.invite(slug, rest[0] || "").catch((e) => die(e.message));
      console.log(inv.url);
      console.error(
        inv.email
          ? inv.mailed
            ? `emailed ${inv.email}`
            : `not emailed (mail is not configured on the server) — send ${inv.email} the link above`
          : "send this link; they run: passalong team join <link>",
      );
      return;
    }
    if (sub === "join") {
      const ref = rest[0] || die("usage: passalong team join <link|code>");
      const code = ref.includes("/") ? ref.split("/").filter(Boolean).pop() : ref;
      const r = await api.join(code).catch((e) => die(e.message));
      store.writeConfig({ team: r.slug });
      console.error(`${r.joined ? "joined" : "already in"} ${r.name} (${r.slug}) — now current`);
      const who = await api.me().catch(() => null);
      if (who && !who.handle) console.error("teammates address you by handle: passalong me --handle <you>");
      return;
    }
    if (sub === "use") {
      const slug = rest[0] || die("usage: passalong team use <slug>");
      await api.team(slug).catch((e) => die(e.message));
      store.writeConfig({ team: slug });
      console.error(`current team: ${slug}`);
      return;
    }
    die("usage: passalong team [create <name> | invite [email] | join <link> | use <slug>]");
  },

  async setup() {
    const skillDir = join(homedir(), ".claude", "skills", "passalong-capture");
    mkdirSync(skillDir, { recursive: true });
    cpSync(join(PKG, "skill"), skillDir, { recursive: true });
    console.error(`installed Claude Code skill → ${skillDir}`);
    try {
      execFileSync("claude", ["mcp", "add", "--scope", "user", "passalong", "--", "passalong", "mcp"], {
        stdio: "pipe",
      });
      console.error("registered MCP server: claude mcp add passalong -- passalong mcp");
    } catch (err) {
      const msg = String(err.stderr || err.message);
      if (/already exists/i.test(msg)) console.error("MCP server already registered");
      else
        console.error(
          `could not register MCP server automatically (${msg.trim()}).\n  run: claude mcp add passalong -- passalong mcp`,
        );
    }
    // The two hooks that keep an agent on what it holds: told at session start, and stopped once
    // before ending with work nobody has handed in. Merged into the user's settings, not written
    // over them, and a no-op when they are already there.
    const settingsPath = join(homedir(), ".claude", "settings.json");
    try {
      const { withHooks, withStatusLine } = await import("../src/hooks.js");
      const before = existsSync(settingsPath) ? JSON.parse(readFileSync(settingsPath, "utf8")) : {};
      const after = withStatusLine(withHooks(before));
      if (before.statusLine && before.statusLine.command !== "passalong now --statusline")
        console.error(
          "you already have a status line, so it was left alone. To show Passalong in it, call `passalong now --statusline` from your script",
        );
      if (JSON.stringify(after) === JSON.stringify(before)) console.error("Claude Code hooks already installed");
      else {
        mkdirSync(dirname(settingsPath), { recursive: true });
        writeFileSync(settingsPath, `${JSON.stringify(after, null, 2)}\n`);
        console.error(`installed Claude Code hooks (session start, stop) and status line → ${settingsPath}`);
      }
    } catch (err) {
      console.error(`could not install Claude Code hooks (${err.message}); ${settingsPath} left as it was`);
    }
    if (!api.loggedIn())
      console.error("sync is off; run `passalong login` when you want guides to follow you across machines");
    console.error('done. In Claude Code, say "pass this along" at the end of a task, or run /passalong-capture.');
  },

  /**
   * What this worktree holds and what is waiting. `--hook session|stop` is the form the Claude
   * Code hooks from `setup` call (src/hooks.js): it prints only what the hook protocol reads, and
   * nothing at all when anything goes wrong — a hook must never get in the way of a session.
   */
  async now(f) {
    const { nowText, statusText, stopVerdict } = await import("../src/hooks.js");
    // The status line: printed from a cache, refreshed behind it. Claude Code cancels a status
    // line still running when the next update comes, so this never waits on the network.
    if (f.statusline) return statusLine(f);
    if (f["statusline-refresh"]) {
      const cwd = typeof f["statusline-refresh"] === "string" ? f["statusline-refresh"] : process.cwd();
      try {
        const r = await passalong.now({ cwd });
        writeStatus(cwd, statusText({ held: r.held, needs: r.needs, ready: r.waiting.ready }));
      } catch {}
      return;
    }
    if (!f.hook) {
      const r = await passalong.now();
      console.log(nowText(r) || "Nothing held here, and nothing waiting.");
      return;
    }
    try {
      let input = {};
      if (f.hook === "stop" && !process.stdin.isTTY) {
        let raw = "";
        for await (const chunk of process.stdin) raw += chunk;
        input = JSON.parse(raw || "{}");
      }
      if (!api.loggedIn()) return;
      // The timeout is cleared as soon as the answer is in. Left running it holds the process open
      // for the full five seconds after the hook has printed, and a session start or a stop that
      // waits five seconds for nothing is the hook getting in the way, which it must never do.
      let timer;
      const r = await Promise.race([
        passalong.now(),
        new Promise((_, no) => {
          timer = setTimeout(() => no(new Error("timeout")), 5000);
        }),
      ]).finally(() => clearTimeout(timer));
      if (f.hook === "session") {
        const text = nowText(r);
        if (text)
          console.log(
            JSON.stringify({
              hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: text },
            }),
          );
      } else if (f.hook === "stop") {
        const v = stopVerdict({ held: r.held, input });
        if (v) console.log(JSON.stringify(v));
      }
    } catch {}
  },

  async mcp() {
    const { serve } = await import("../src/mcp.js");
    await serve();
  },

  /**
   * Ask the registry what the latest version is and write it down. Not in the help, because it is
   * not for a person: `passalong` spawns it, detached, when the answer on file is a day old.
   */
  async ["refresh-update"]() {
    const { refresh } = await import("../src/update.js");
    await refresh();
  },

  async help() {
    const src = readFileSync(fileURLToPath(import.meta.url), "utf8");
    const lines = src.split("\n").filter((l) => l.startsWith("//   passalong "));
    console.log("passalong — hand finished work to another context\n");
    console.log(lines.map((l) => l.slice(3)).join("\n"));
  },
};

const argv = flags(process.argv.slice(2));
const cmd = argv._.shift() || "help";
// The first thing anyone runs when something is off, and until now it printed the help page. The
// parser only knows `--x`, so `--version` arrives as a flag on an empty command and `-v` as a word;
// both are caught here, with `version`, before dispatch. Only the number goes to stdout, so
// `passalong -v` can be read by a script comparing it against the registry.
if (cmd === "-v" || cmd === "version" || (cmd === "help" && argv.version === true)) {
  console.log(JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version);
} else if (cmd === "--help" || cmd === "-h" || cmd === "help") commands.help();
// A command this build does not have used to print the help page and exit 0, which reads as "that
// command exists and did nothing" — and the usual cause is an older passalong, where the command is
// in the docs and not in the binary. So it fails, names what it does not know, and says the version
// it is, which is the fact that explains it.
else if (!commands[cmd])
  die(
    `unknown command "${cmd}" — run \`passalong help\` for the list. ` +
      `This is passalong ${JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version}; ` +
      "if you expected this command, `npm i -g passalong` for the newest one.",
  );
else {
  await commands[cmd](argv).catch((e) => die(e.message));
  // After the command, never before it: a version check is not worth a millisecond of somebody's
  // first impression, and it must never be the reason a command felt slow. `mcp` is a server that
  // does not return, and the hooks are read by an agent rather than a person — a line neither of
  // them asked for is noise in a transcript.
  if (!["mcp", "now", "refresh-update"].includes(cmd)) {
    try {
      const { cachedNotice } = await import("../src/update.js");
      const current = JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version;
      const { notice, stale } = cachedNotice({ current });
      if (notice) console.error(notice);
      // The refresh is a process this one does not wait for: detached, output thrown away,
      // unref'd so the exit is not held open by it. Measuring the alternative is what settled it —
      // the registry took six to ten seconds to answer, so awaiting it meant every command paid
      // that or the check silently never worked.
      if (stale) {
        const child = spawn(process.execPath, [fileURLToPath(import.meta.url), "refresh-update"], {
          detached: true,
          stdio: "ignore",
        });
        child.unref();
      }
    } catch {
      // Nothing about being out of date is worth failing a command that already worked.
    }
  }
}
