#!/usr/bin/env node
// Passalong CLI. Few flags on purpose: the defaults are the product.
//
//   passalong new "<what needs doing>" [--to TARGET] [--parent ID] [--draft]  write work down
//   passalong new <file.md> [--to TARGET] [--parent ID] [--draft]  the same, from a file
//     TARGET is a team, team/@handle for one person, or "team/#group" for the people who do a
//     thing — quote that one, since a shell may read the # as a comment
//   passalong board               what needs you, who is on what, and what is ready
//   passalong list [query]        work you and your teams can see, newest first
//   passalong open <id> [--print] view work in the browser (or the terminal)
//   passalong take [id] [--save]  you are doing it: nobody else can take it while you hold it
//   passalong progress <id> <note>  still on it, with a one-line note the hub shows
//   passalong hand-in <id> <note> --evidence TEXT [--writeup TEXT] [--pr LINK]  it is done
//   passalong pass <id> <why>     it is not yours, or you are stuck — hands it back with your reason
//   passalong ask <id> <question> ask the person, keep it, and wait for their answer
//   passalong reply <id> <text>   write to whoever holds it (--file PATH to attach); or leave a note
//   passalong assign <id> <to>    give it to @handle (or several: @ada @bola), a #group, or "team"
//   passalong release <id>        take work back from whoever holds it
//   passalong reopen <id> <why>   finished work isn't right: back to To do, and whoever takes it next reads why
//   passalong ready <id...|--all> work you have read is Ready — whoever it is for may take it now
//   passalong archive <id>        off the board and out of the free tier's count
//   passalong rm <id>             delete it
//   passalong attach <file>       upload a picture or a file and print the markdown that points at it
//   passalong work [--once] [--agent CMD]  run an agent on each piece of ready work here, one after another
//   passalong work --watch [--every SECS]  the runner: keep taking work marked safe to run alone
//   passalong hub                 open the hub in the browser
//   passalong export [dir]        dump every piece of work as plain markdown (default ./passalong-export)
//   passalong admin create <email>   make an account that runs Passalong (owner only)
//   passalong admin list          who runs it
//   passalong admin grant|revoke <@handle>   make an existing account an admin, or stop it being one
//   passalong gift <who> --until <date> [--why "..."] [--seats N]
//                                 give Solo to @handle, or Team to team/slug, until a date (operator only)
//   passalong gifts               what has been given away, and what is still running
//   passalong ungift <gift id>    take one back now
//   passalong login               sign in from the browser
//   passalong login --with-token  read a token from stdin instead (CI, scripts)
//   passalong login --new         add another account to this machine
//   passalong accounts            the accounts signed in here, and which is the default
//   passalong use <name>          make one of them the default
//   passalong logout [name]       forget one of them (default: the current one)
//   passalong me [--handle H] [--name N] [--email E]   who you are to teammates
//   passalong team                current team and its members
//   passalong team create <name>  start a team (you become its owner)
//   passalong team invite [email] make an invite link (mailed when an email is given)
//   passalong team join <link|code>  accept an invite
//   passalong team use <slug>     switch the current team
//   passalong team promote|demote <@handle>  make a teammate an admin, or a member again
//   passalong team remove <@handle>  take a teammate out; `team leave` leaves yourself
//   passalong setup               install the Claude Code capture skill, MCP server and hooks
//   passalong now                 what this worktree holds and what is waiting (the hooks call --hook)
//   passalong mcp                 run the MCP server over stdio
//   passalong version             print the installed version (also -v, --version)
import { execFileSync, spawn, spawnSync } from "node:child_process";
import { createHash, randomBytes } from "node:crypto";
import { cpSync, existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir, hostname } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import * as api from "../src/api.js";
import { workScaffold } from "../src/capture.js";
import { parse, serialize } from "../src/work.js";
import * as passalong from "../src/passalong.js";
import * as store from "../src/store.js";

const PKG = resolve(dirname(fileURLToPath(import.meta.url)), "..");

function flags(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith("--")) {
      const next = argv[i + 1];
      const key = t.slice(2);
      const value = next === undefined || next.startsWith("-") ? true : argv[++i];
      // A flag given twice keeps both, so `--file a.pdf --file b.csv` is two files. Nothing else
      // repeats a flag, so nothing else sees an array.
      out[key] = key in out && value !== true ? [out[key], value].flat() : value;
    } else out._.push(t);
  }
  return out;
}

function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}

const tty = process.stdout.isTTY && process.stdin.isTTY;

/**
 * One line typed at the terminal. `hidden` turns the echo off, so a password does not end up in a
 * screen share, a scrollback or somebody's terminal recording.
 *
 * Written against readline rather than a dependency because this package has none beyond the MCP
 * SDK and zod, and asking for a line of text is not where that changes.
 */
/** Open a page in the default browser, and say nothing if there is none to open. */
function openPage(url) {
  const [cmd, args] =
    process.platform === "darwin"
      ? ["open", [url]]
      : process.platform === "win32"
        ? ["cmd", ["/c", "start", "", url]]
        : ["xdg-open", [url]];
  try {
    spawn(cmd, args, { detached: true, stdio: "ignore" }).on("error", () => {}).unref();
  } catch {}
}

/**
 * Keep a login under a name, and say what that did. The first one on a machine is the default; one
 * added beside it is not, because a default that changes by itself is how an agent ends up acting
 * as the wrong person. A machine that has only the older single login gets that one named first,
 * so adding a second does not lose it.
 */
async function keepLogin(token, base = api.baseUrl()) {
  const who = await api.meWith(token, base).catch((e) => die(`token rejected: ${e.message}`));
  const cfg = store.readConfig();
  if (cfg.token && !cfg.accounts && cfg.token !== token) {
    const old = await api.meWith(cfg.token, cfg.api || base).catch(() => null);
    store.saveAccount(
      { token: cfg.token, api: cfg.api || base, account: old?.account || "", handle: old?.handle || "", email: old?.email || "", team: cfg.team || "" },
      { activate: true },
    );
  }
  const before = Object.keys(store.readAccounts()).length;
  const name = store.saveAccount(
    { token, api: base, account: who.account, handle: who.handle || "", email: who.email || "" },
    { activate: before === 0 },
  );
  if (!api.currentTeam() && who.teams?.length === 1) store.saveTeam(name, who.teams[0].slug);
  const now = store.readConfig();
  const count = Object.keys(store.readAccounts(now)).length;
  console.error(`signed in as ${name} (account ${who.account}) on ${base}. Sync is on.`);
  if (count > 1)
    console.error(
      `${count} accounts are signed in here; the default is ${now.active}. ` +
        (now.active === name ? "" : `Switch it with \`passalong use ${name}\`. `) +
        "Agents are asked which to use each session.",
    );
  return { name, who };
}

/**
 * Sign in by approving in the browser: show a code, wait, and be handed a token. No password is
 * typed here and no token is pasted between windows. Needs no terminal to ask on, so an agent can
 * run it and tell the person which page to open.
 */
async function browserLogin() {
  const verifier = randomBytes(32).toString("hex");
  const challenge = createHash("sha256").update(verifier).digest("hex");
  const start = await api.deviceStart(challenge, `${hostname()} cli`).catch((e) => die(e.message));
  console.error(`Open ${start.url}`);
  console.error(`and check the page shows the code ${start.code}, then press Approve.`);
  if (tty) openPage(start.url);
  console.error("Waiting for you to approve it here… (Ctrl-C to stop)");
  const until = Date.now() + start.expires_in * 1000;
  while (Date.now() < until) {
    await new Promise((r) => setTimeout(r, start.interval * 1000));
    const got = await api.devicePoll(start.id, verifier).catch((e) => die(e.message));
    if (!got) continue;
    await keepLogin(got.token);
    console.error("Give teammates a name to address you by: passalong me --handle <you>");
    return;
  }
  die("nobody approved it in time. Run `passalong login` again.");
}

/** A token piped in, for machines with no browser: `passalong login --with-token < token.txt`. */
async function stdinLogin() {
  if (process.stdin.isTTY) die("--with-token reads the token from stdin: passalong login --with-token < token.txt");
  let raw = "";
  for await (const chunk of process.stdin) raw += chunk;
  const token = raw.trim();
  if (!token) die("no token on stdin");
  await keepLogin(token);
}

function edit(path) {
  const editor = process.env.VISUAL || process.env.EDITOR || "vi";
  const r = spawnSync(editor, [path], { stdio: "inherit", shell: true });
  if (r.status !== 0) die(`${editor} exited with ${r.status}`);
}

function openInBrowser(url) {
  const cmd =
    process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  spawnSync(cmd, [url], { stdio: "ignore", shell: process.platform === "win32" });
}

function relDate(iso) {
  if (!iso) return "";
  const d = (Date.now() - new Date(iso).getTime()) / 864e5;
  if (d < 1 / 24) return "just now";
  if (d < 1) return `${Math.floor(d * 24)}h ago`;
  if (d < 30) return `${Math.floor(d)}d ago`;
  return iso.slice(0, 10);
}

function workLine(r) {
  const who = r.team ? `  ${r.team}${r.to ? `/${r.to}` : ""}${r.mine ? "" : ` from @${r.from || "?"}`}` : "";
  const tags = r.tags?.length ? `  #${r.tags.join(" #")}` : "";
  return `${r.id}  ${r.status.padEnd(9)} ${relDate(r.created).padEnd(10)} ${r.title}${who}${tags}`;
}

// ---- the status line cache --------------------------------------------------------------------------

/** One small file per working directory, so two sessions in two repos each see their own. */
const statusPath = (cwd) =>
  join(store.HOME, "statusline", `${createHash("sha1").update(cwd).digest("hex").slice(0, 16)}.json`);

function writeStatus(cwd, text) {
  const p = statusPath(cwd);
  mkdirSync(dirname(p), { recursive: true });
  writeFileSync(p, JSON.stringify({ at: Date.now(), text }));
}

/** How old a cached line may be before a refresh is started behind it. */
const STATUS_TTL_MS = 30_000;

/**
 * Print the cached line for this directory at once, and when it is stale start a detached refresh
 * that writes the next one. The first run in a directory prints a placeholder; the refresh lands
 * within a second or two, and the next update shows it. Offline or signed out, it says nothing.
 */
async function statusLine() {
  let input = {};
  if (!process.stdin.isTTY) {
    let raw = "";
    for await (const chunk of process.stdin) raw += chunk;
    try {
      input = JSON.parse(raw || "{}");
    } catch {}
  }
  if (!api.loggedIn()) return;
  const cwd = input.workspace?.current_dir || input.cwd || process.cwd();
  let cached = null;
  try {
    cached = JSON.parse(readFileSync(statusPath(cwd), "utf8"));
  } catch {}
  process.stdout.write(cached?.text ?? "passalong");
  if (!cached || Date.now() - cached.at > STATUS_TTL_MS) {
    // Marked fresh before the refresh starts, so a burst of updates starts one refresh, not ten.
    writeStatus(cwd, cached?.text ?? "passalong");
    spawn(process.execPath, [fileURLToPath(import.meta.url), "now", "--statusline-refresh", cwd], {
      detached: true,
      stdio: "ignore",
      env: process.env,
    }).unref();
  }
}

const commands = {
  /**
   * Write work down: a sentence becomes its title, summary and text, or a file is sent as it is. At
   * a terminal it opens in $EDITOR first, so whoever wrote it can add to it before it goes.
   */
  async new(f) {
    const arg =
      f._.join(" ").trim() ||
      die('usage: passalong new "<what needs doing>" | <file.md> [--to TARGET] [--parent ID] [--draft]');
    let path = arg;
    if (!(arg.endsWith(".md") && existsSync(arg))) {
      path = store.draftPath(`work-${new Date().toISOString().replace(/[:.]/g, "-")}`);
      writeFileSync(path, workScaffold(arg));
    }
    if (tty && !f["no-edit"]) edit(path);
    const g = parse(readFileSync(path, "utf8"));
    if (f.draft) g.meta.status = "draft";
    const { work, url } = await passalong
      .publish(serialize(g), {
        to: typeof f.to === "string" ? f.to : undefined,
        parent: typeof f.parent === "string" ? f.parent : undefined,
      })
      .catch((e) => die(`${e.message}\nkept at ${path} — fix it and run \`passalong new ${path}\``));
    // A draft that went out is spent. removeDraft() touches nothing outside the drafts directory.
    store.removeDraft(resolve(path));
    console.log(work.meta.id);
    const where = work.meta.team ? ` for ${work.meta.team}${work.meta.to ? `/${work.meta.to}` : ""}` : "";
    console.error(`"${work.meta.title}" is ${work.meta.status === "draft" ? "in Draft" : "Ready"}${where}`);
    console.error(`link: ${url}`);
  },

  async board() {
    const b = await passalong.board().catch((e) => die(e.message));
    const section = (title, rows, line) => {
      if (!rows.length) return;
      console.log(`\n${title} · ${rows.length}`);
      for (const r of rows) console.log(`  ${r.id}  ${line(r)}`);
    };
    section("Needs you", b.needs, (n) => `${n.title}  — ${n.why}`);
    section("Being worked on", b.working, (w) =>
      `${w.title}  ${w.who}${w.stalled ? " (went quiet)" : ""}${w.note ? `  "${w.note}"` : ""}`);
    section("Ready", b.ready, (t) => `${t.title}${t.target ? `  [${t.target}]` : ""}${t.to ? `  for ${t.to}` : ""}`);
    if (!b.needs.length && !b.working.length && !b.ready.length) console.error("nothing open");
    console.error(`\n${b.counts.done} done. The board: ${b.hub}/work`);
  },

  async list(f) {
    const scope = typeof f.team === "string" ? f.team : f.mine ? "mine" : "";
    const rows = await passalong.list(f._.join(" "), { scope }).catch((e) => die(e.message));
    if (!rows.length) return console.error('no work yet — write some with: passalong new "<what needs doing>"');
    for (const r of rows) console.log(workLine(r));
  },

  async open(f) {
    const id = f._[0] || die("usage: passalong open <id>");
    const { work } = await passalong.resolve(id).catch((e) => die(e.message));
    if (work.meta.url && tty && !f.print) {
      openInBrowser(work.meta.url);
      console.error(work.meta.url);
    } else {
      process.stdout.write(serialize(work));
      if (work.meta.url) console.error(`\nlink: ${work.meta.url}`);
    }
  },

  /**
   * Take it: you are doing it, and nobody else can take it while you hold it. It is printed, and
   * `--save` also writes it to ./.passalong/. With no id, the next piece of work waiting here.
   */
  async take(f) {
    const r = await passalong.take(f._[0], { save: Boolean(f.save) }).catch((e) => die(e.message));
    if (!r.work?.markdown) return console.error(r.say || "nothing to take");
    process.stdout.write(r.work.markdown);
    if (r.path) console.error(`\nsaved to ${r.path}`);
    console.error(`\nyou hold ${r.work.id} — hand it in when it is done, or pass it with the reason`);
  },

  async progress(f) {
    const id = f._[0] || die("usage: passalong progress <id> <note>");
    await passalong.progress(id, f._.slice(1).join(" ")).catch((e) => die(e.message));
    console.error(`${id} — still yours`);
  },

  async ["hand-in"](f) {
    const id = f._[0] || die("usage: passalong hand-in <id> <note> --evidence TEXT");
    const note = f._.slice(1).join(" ") || die("say in one sentence what you did: passalong hand-in <id> <note>");
    const r = await passalong
      .handIn(id, {
        note,
        evidence: typeof f.evidence === "string" ? f.evidence : "",
        writeup: typeof f.writeup === "string" ? f.writeup : "",
        pr: typeof f.pr === "string" ? f.pr : "",
      })
      .catch((e) => die(e.message));
    console.error(`${id} is ${r.state === "done" ? "Done" : "handed in here; others still hold it"}`);
  },

  async pass(f) {
    const id = f._[0] || die("usage: passalong pass <id> <why it is not yours>");
    const why = f._.slice(1).join(" ");
    // Required, and the reason is the whole point: "not me" without "why" leaves the sender where
    // the silence did, still guessing whether to re-address it, wait, or go and ask.
    if (!why) die("say why you are passing: passalong pass <id> <why it is not yours>");
    await passalong.pass(id, why).catch((e) => die(e.message));
    console.error(`${id} handed back with your reason: "${why}"`);
  },

  async ask(f) {
    const id = f._[0] || die("usage: passalong ask <id> <question>");
    await passalong.ask(id, f._.slice(1).join(" ")).catch((e) => die(e.message));
    console.error(`${id} — asked. It is still yours; take it again once they have replied`);
  },

  /**
   * Write to whoever holds a piece of work, or leave a note on one nobody holds yet. The person's
   * side of `ask`: an agent that stopped to wait hears this when it takes the work again.
   */
  async reply(f) {
    const id = f._[0] || die("usage: passalong reply <id> <message> [--file PATH ...]");
    const files = [f.file].flat().filter((x) => typeof x === "string");
    const said = f._.slice(1).join(" ");
    if (!said && !files.length) die("say something, or attach a file: passalong reply <id> <message>");
    const r = await passalong.reply(id, said, { files }).catch((e) => die(e.message));
    console.error(
      r?.noted
        ? `${id} — nobody holds it yet, so this is a note: whoever takes it is handed it first`
        : `${id} — sent. Whoever holds it reads it the next time it checks in`,
    );
  },

  async assign(f) {
    const id = f._[0] || die('usage: passalong assign <id> <@handle | #group | team>');
    const to = f._.slice(1).join(",") || die('say who: @handle (or several), #group, or "team" for everyone');
    const r = await passalong.assign(id, to).catch((e) => die(e.message));
    const back = r.taken_back ? ` — taken back from ${r.taken_back} who had it, and they were told` : "";
    console.error(`${r.id} is now for ${r.to || "everyone in the team"}${back}`);
  },

  async release(f) {
    const id = f._[0] || die("usage: passalong release <id>");
    await passalong.release(id).catch((e) => die(e.message));
    console.error(`${id} is back in Ready — whoever had it has been told`);
  },

  /** Finished work back to To do, with why at its top; whoever finished it is told. */
  async reopen(f) {
    const id = f._[0] || die("usage: passalong reopen <id> <why>");
    const why = f._.slice(1).join(" ");
    if (!why) die("say why: passalong reopen <id> <what is wrong>");
    await passalong.reopen(id, why).catch((e) => die(e.message));
    console.error(`${id} is back in To do — whoever takes it next reads why`);
  },

  async ready(f) {
    if (f.all) {
      const ids = await passalong.readyDrafts().catch((e) => die(e.message));
      if (!ids.length) return console.error("no drafts of yours to make ready");
      for (const id of ids) console.log(id);
      return console.error(`${ids.length} Ready — whoever they are for may take them`);
    }
    if (!f._.length) die("usage: passalong ready <id...> | --all");
    for (const ref of f._) {
      const id = await passalong.ready(ref).catch((e) => die(e.message));
      console.error(`${id} is Ready — whoever it is for may take it`);
    }
  },

  /** Archive: off the board, and out of what the free tier counts. It comes back to Draft. */
  async archive(f) {
    const id = f._[0] || die("usage: passalong archive <id>");
    await passalong.setStatus(id, "done").catch((e) => die(e.message));
    console.error(`${id} archived — off the board, and it no longer counts against your plan`);
  },

  async rm(f) {
    const id = f._[0] || die("usage: passalong rm <id>");
    await passalong.remove(id).catch((e) => die(e.message));
    console.error(`${id} removed`);
  },

  /** Upload a picture or a file and print the markdown that points at it. */
  async attach(f) {
    const file = f._[0] || die("usage: passalong attach <file> [--name LABEL]");
    const got = await passalong.attachAny(file, { name: f.name || "" }).catch((e) => die(e.message));
    process.stdout.write(`${got.markdown}\n`);
    console.error(`uploaded ${got.bytes} bytes → ${got.url}`);
  },

  /**
   * Work the queue from this worktree until it is empty. The agent is `claude -p` unless --agent or
   * PASSALONG_AGENT says otherwise, e.g. "claude -p --permission-mode acceptEdits" so it can edit
   * files without asking — which is yours to decide, not this command's.
   */
  async work(f) {
    // The runner: only work a person marked safe to run alone, waiting for more when there is none.
    const watch = Boolean(f.watch);
    let idle = false;
    if (watch)
      console.error("Runner: taking only work marked safe to run alone. Stop it with Ctrl-C.");
    const run = await passalong
      .work({
        agent: typeof f.agent === "string" ? f.agent : undefined,
        once: Boolean(f.once),
        any: Boolean(f.any),
        watch,
        every: Number(f.every) || 60,
        onTask: (t) => {
          idle = false;
          console.error(`\n→ ${t.id}  ${t.title}${t.resumed ? "  (resuming)" : ""}`);
        },
        onIdle: () => {
          if (!idle) console.error("waiting for work marked safe to run alone…");
          idle = true;
        },
        onUnfinished: (t, state) =>
          console.error(
            `✗ ${t.id} is still ${state || "open"}: left held here; the sweep puts it back if it goes quiet`,
          ),
      })
      .catch((e) => die(e.message));
    for (const id of run.finished) console.log(id);
    const n = run.finished.length;
    const done = `${n} finished`;
    if (run.stopped === "unfinished")
      die(
        `${done}. Stopped: the agent exited with ${run.task} still ${run.state || "open"} — ` +
          `run again to resume it, or \`passalong release ${run.task}\``,
      );
    console.error(`${done}${run.stopped === "empty" ? " — nothing left for this repo" : ""}`);
  },

  async hub() {
    if (!api.loggedIn()) die("not logged in — run `passalong login` first");
    // The token rides in the URL fragment: the browser never sends it to the server, and the
    // page moves it into localStorage and scrubs the address bar on load.
    const url = `${api.baseUrl()}/hub#token=${encodeURIComponent(api.token())}`;
    if (tty) {
      openInBrowser(url);
      console.error(`${api.baseUrl()}/hub`);
    } else console.log(url);
  },

  async export(f) {
    const dir = resolve(f._[0] || "passalong-export");
    const paths = await passalong.exportAll(dir).catch((e) => die(e.message));
    console.error(`exported ${paths.length} → ${dir}`);
  },

  // ---- who runs the product ---------------------------------------------------------------
  // `passalong admin <create|list|grant|revoke>`. An admin signs in like anybody else: the role is
  // a column, so there is no admin password and no admin token — only an account that has it.
  // "admin" is the word everywhere a person reads; `super` stays the stored value.

  async admin(f) {
    const what = f._[0] || "list";
    if (what === "create") {
      const email = f._[1] || die("usage: passalong admin create <email>");
      const r = await api.makeAdmin(email).catch((e) => die(e.message));
      // Shown once, and only here. The link is a day long because it is handed to somebody
      // rather than clicked on the spot.
      // Three labelled values on stdout, so one can be cut out with awk. "password link", not
      // "password": the value is a URL, and somebody will try to paste it into a password field.
      console.log(`account        ${r.account}`);
      console.log(`token          ${r.token}`);
      console.log(`password link  ${r.password_url}`);
      console.error(
        `\n${r.email} is an admin. The token is for \`passalong login --with-token\`, the link sets their ` +
          `password for the hub, and it expires ${r.expires.slice(0, 10)}. Neither is shown again.`,
      );
      return;
    }
    if (what === "grant" || what === "revoke") {
      const who = f._[1] || die(`usage: passalong admin ${what} <@handle | account id>`);
      const call = what === "grant" ? api.grantAdmin : api.revokeAdmin;
      const r = await call(who).catch((e) => die(e.message));
      console.error(
        what === "grant" ? `${r.name} is now an admin` : `${r.name} is no longer an admin`,
      );
      return;
    }
    if (what !== "list") die("usage: passalong admin <create <email> | list | grant | revoke>");
    const { supers = [] } = await api.listAdmins().catch((e) => die(e.message));
    if (!supers.length) return console.error("nobody is an admin yet");
    for (const s of supers)
      console.log(`${s.id}  ${s.name}${s.email ? `  ${s.email}` : ""}  since ${s.since.slice(0, 10)}`);
  },

  // ---- giving a plan away -----------------------------------------------------------------
  // Only for whoever the deployment names in ADMIN_ACCOUNTS; for everybody else the routes behind
  // these are 404, and the message says so rather than pretending the command does not exist.

  async gift(f) {
    const to = f._[0] || die('usage: passalong gift <@handle | team/slug> --until 2027-09-23 [--why "..."]');
    const until = f.until || die("say when it ends: --until 2027-09-23. A gift with no end is a price change");
    const r = await api
      .giveGift({ to, until, why: f.why || "", seats: Number(f.seats || 0) })
      .catch((e) => die(e.message));
    // The seat count is said back whether or not it was asked for: left off, it is the number of
    // members the team has today, and an operator should read which number that turned out to be.
    const seats = r.kind === "team" ? ` for ${r.seats} seat${r.seats === 1 ? "" : "s"}` : "";
    console.error(`${r.to} is on ${r.plan}${seats} until ${r.until.slice(0, 10)} — gift ${r.id}`);
  },

  async gifts() {
    const { gifts = [] } = await api.listGifts().catch((e) => die(e.message));
    if (!gifts.length) return console.error("no plans given away yet");
    for (const g of gifts) {
      const state = g.live ? `until ${g.until.slice(0, 10)}` : "over";
      console.log(
        `${g.id}  ${g.plan.padEnd(5)} ${state.padEnd(16)} ${g.to}${g.why ? ` — ${g.why}` : ""}`,
      );
    }
  },

  async ungift(f) {
    const id = f._[0] || die("usage: passalong ungift <gift id>  (passalong gifts lists them)");
    await api.takeGiftBack(id).catch((e) => die(e.message));
    console.error(`${id} taken back — that plan is lapsed as of now`);
  },

  async login(f) {
    // A token on the command line lands in shell history, so it is only read from stdin.
    if (f._[0]) die("pass a token on stdin instead: passalong login --with-token < token.txt");
    if (f.email || f.password)
      die("password sign-in is gone: run `passalong login` and approve it in the browser");
    if (f["with-token"]) return stdinLogin();
    if (api.loggedIn() && !f.new) {
      const who = await api.me().catch(() => null);
      if (who) {
        console.error(`already logged in as ${who.handle ? `@${who.handle}` : who.email || who.account}.`);
        console.error("Add another account to this machine with `passalong login --new`.");
        return;
      }
    }
    // The browser works with no terminal at all — an agent can start it, and the person it is
    // working for clicks once.
    return browserLogin();
  },

  /** The accounts signed in here, with the default marked. */
  async accounts() {
    const cfg = store.readConfig();
    const all = store.readAccounts(cfg);
    const names = Object.keys(all);
    if (!names.length) {
      console.log(
        cfg.token
          ? "one account is signed in here (a login from before accounts had names). `passalong login --new` adds another."
          : "no account is signed in here — passalong login",
      );
      return;
    }
    for (const n of names) {
      const a = all[n];
      const who = [a.handle ? `@${a.handle}` : "", a.email].filter(Boolean).join("  ");
      console.log(`${n === cfg.active ? "*" : " "} ${n}${who ? `  ${who}` : ""}  ${a.api}`);
    }
    if (names.length > 1)
      console.log("\n* is the default for a person at a terminal. Agents are asked which to use each session.");
  },

  /** Make one of them the default. This changes what a terminal gets, never what a session of an agent is told. */
  async use(f) {
    const name = f._[0] || die("usage: passalong use <name> (see `passalong accounts`)");
    if (!store.readAccounts()[name])
      die(`no account called "${name}" here. Signed in: ${Object.keys(store.readAccounts()).join(", ") || "none"}`);
    store.setActive(name);
    console.error(`the default account is now ${name}`);
  },

  /** Forget one of them on this machine. The account itself is untouched: only its token here goes. */
  async logout(f) {
    const name = f._[0] || store.readConfig().active || die("not logged in (see `passalong accounts`)");
    const r = store.removeAccount(name);
    if (!r.removed) die(`no account called "${name}" here`);
    console.error(
      r.active
        ? `signed out of ${name}; the default is now ${r.active}`
        : `signed out of ${name}; no account is signed in here now`,
    );
  },

  async me(f) {
    const patch = {};
    for (const k of ["handle", "name", "email"]) if (typeof f[k] === "string") patch[k] = f[k];
    const who = Object.keys(patch).length
      ? await api.updateMe(patch).then(api.me).catch((e) => die(e.message))
      : await api.me().catch((e) => die(e.message));
    console.log(`account  ${who.account}`);
    console.log(`handle   ${who.handle ? `@${who.handle}` : "(none — set one: passalong me --handle <you>)"}`);
    if (who.name) console.log(`name     ${who.name}`);
    if (who.email) console.log(`email    ${who.email}`);
    // The server sends the state by name, because a number cannot tell "no ceiling" apart from
    // "may sync nothing" — both of which arrive as a falsy limit.
    const ceiling =
      who.sync === "free"
        ? ` (${who.limit} active on your plan)`
        : who.sync === "none"
          ? " (no plan — nothing is syncing)"
          : " (no limit on your plan)";
    console.log(`work     ${who.work} active${ceiling}`);
    const current = api.currentTeam();
    console.log(
      `teams    ${who.teams.length ? who.teams.map((t) => `${t.slug}${t.slug === current ? "*" : ""} (${t.role})`).join(", ") : "(none — passalong team create <name>)"}`,
    );
  },

  async team(f) {
    const [sub, ...rest] = f._;
    const cfg = { team: api.currentTeam() };
    if (!sub) {
      if (!cfg.team) {
        const { teams } = await api.teams().catch((e) => die(e.message));
        if (!teams.length) return console.error("no team yet — passalong team create <name>");
        return console.error(`you are in ${teams.map((t) => t.slug).join(", ")}; pick one: passalong team use <slug>`);
      }
      const t = await api.team(cfg.team).catch((e) => die(e.message));
      console.log(`${t.name} (${t.slug}) — ${t.members.length} member${t.members.length === 1 ? "" : "s"}, ${t.work} piece${t.work === 1 ? "" : "s"} of work`);
      for (const m of t.members)
        console.log(`  ${m.handle ? `@${m.handle}` : "(no handle)"}${m.name ? `  ${m.name}` : ""}  ${m.role === "owner" ? "admin" : m.role}  joined ${relDate(m.joined)}`);
      return;
    }
    if (sub === "create") {
      const name = rest.join(" ") || die("usage: passalong team create <name>");
      const t = await api.createTeam(name).catch((e) => die(e.message));
      api.setTeam(t.slug);
      console.error(`team ${t.name} created as "${t.slug}" — now current. Invite people: passalong team invite [email]`);
      return;
    }
    if (sub === "invite") {
      const slug = cfg.team || die("no current team — passalong team use <slug>");
      const inv = await api.invite(slug, rest[0] || "").catch((e) => die(e.message));
      console.log(inv.url);
      console.error(
        inv.email
          ? inv.mailed
            ? `emailed ${inv.email}`
            : `not emailed (mail is not configured on the server) — send ${inv.email} the link above`
          : "send this link; they run: passalong team join <link>",
      );
      return;
    }
    if (sub === "join") {
      const ref = rest[0] || die("usage: passalong team join <link|code>");
      const code = ref.includes("/") ? ref.split("/").filter(Boolean).pop() : ref;
      const r = await api.join(code).catch((e) => die(e.message));
      api.setTeam(r.slug);
      console.error(`${r.joined ? "joined" : "already in"} ${r.name} (${r.slug}) — now current`);
      const who = await api.me().catch(() => null);
      if (who && !who.handle) console.error("teammates address you by handle: passalong me --handle <you>");
      return;
    }
    if (sub === "promote" || sub === "demote") {
      const slug = cfg.team || die("no current team — passalong team use <slug>");
      const who = rest[0] || die(`usage: passalong team ${sub} <@handle>`);
      const r = await api.setMemberRole(slug, who, sub === "promote" ? "admin" : "member").catch((e) => die(e.message));
      console.error(`${who.startsWith("@") ? who : `@${who}`} is ${r.role === "admin" ? "an admin" : "a member"} of ${slug}${sub === "promote" ? " — they are told" : ""}`);
      return;
    }
    if (sub === "remove" || sub === "leave") {
      const slug = cfg.team || die("no current team — passalong team use <slug>");
      const me = sub === "leave" ? (await api.me().catch((e) => die(e.message))).account : "";
      const who = sub === "leave" ? me : rest[0] || die("usage: passalong team remove <@handle>");
      const r = await api.removeMember(slug, who).catch((e) => die(e.message));
      console.error(sub === "leave" ? `you left ${slug}` : `${who.startsWith("@") ? who : `@${who}`} is out of ${slug}${r.released ? `; ${r.released} hold${r.released === 1 ? "" : "s"} of theirs went back to waiting` : ""}`);
      if (sub === "leave") api.setTeam("");
      return;
    }
    if (sub === "use") {
      const slug = rest[0] || die("usage: passalong team use <slug>");
      await api.team(slug).catch((e) => die(e.message));
      api.setTeam(slug);
      console.error(`current team: ${slug}`);
      return;
    }
    die("usage: passalong team [create <name> | invite [email] | join <link> | use <slug> | promote <@handle> | demote <@handle> | remove <@handle> | leave]");
  },

  async setup() {
    const skillDir = join(homedir(), ".claude", "skills", "passalong-capture");
    mkdirSync(skillDir, { recursive: true });
    cpSync(join(PKG, "skill"), skillDir, { recursive: true });
    console.error(`installed Claude Code skill → ${skillDir}`);
    try {
      execFileSync("claude", ["mcp", "add", "--scope", "user", "passalong", "--", "passalong", "mcp"], {
        stdio: "pipe",
      });
      console.error("registered MCP server: claude mcp add passalong -- passalong mcp");
    } catch (err) {
      const msg = String(err.stderr || err.message);
      if (/already exists/i.test(msg)) console.error("MCP server already registered");
      else
        console.error(
          `could not register MCP server automatically (${msg.trim()}).\n  run: claude mcp add passalong -- passalong mcp`,
        );
    }
    // The two hooks that keep an agent on what it holds: told at session start, and stopped once
    // before ending with work nobody has handed in. Merged into the user's settings, not written
    // over them, and a no-op when they are already there.
    const settingsPath = join(homedir(), ".claude", "settings.json");
    try {
      const { withHooks, withStatusLine } = await import("../src/hooks.js");
      const before = existsSync(settingsPath) ? JSON.parse(readFileSync(settingsPath, "utf8")) : {};
      const after = withStatusLine(withHooks(before));
      if (before.statusLine && before.statusLine.command !== "passalong now --statusline")
        console.error(
          "you already have a status line, so it was left alone. To show Passalong in it, call `passalong now --statusline` from your script",
        );
      if (JSON.stringify(after) === JSON.stringify(before)) console.error("Claude Code hooks already installed");
      else {
        mkdirSync(dirname(settingsPath), { recursive: true });
        writeFileSync(settingsPath, `${JSON.stringify(after, null, 2)}\n`);
        console.error(`installed Claude Code hooks (session start, stop) and status line → ${settingsPath}`);
      }
    } catch (err) {
      console.error(`could not install Claude Code hooks (${err.message}); ${settingsPath} left as it was`);
    }
    if (!api.loggedIn()) console.error("not signed in yet: run `passalong login`");
    console.error(
      'done. In Claude Code, say "pass this along" to write what a session learned into the project\'s documents, or run /passalong-capture.',
    );
  },

  /**
   * What this worktree holds and what is waiting. `--hook session|stop` is the form the Claude
   * Code hooks from `setup` call (src/hooks.js): it prints only what the hook protocol reads, and
   * nothing at all when anything goes wrong — a hook must never get in the way of a session.
   */
  async now(f) {
    const { nowText, statusText, stopDecision } = await import("../src/hooks.js");
    // The status line: printed from a cache, refreshed behind it. Claude Code cancels a status
    // line still running when the next update comes, so this never waits on the network.
    if (f.statusline) return statusLine(f);
    if (f["statusline-refresh"]) {
      const cwd = typeof f["statusline-refresh"] === "string" ? f["statusline-refresh"] : process.cwd();
      try {
        const r = await passalong.now({ cwd });
        writeStatus(cwd, statusText(r));
      } catch {}
      return;
    }
    if (!f.hook) {
      const r = await passalong.now();
      console.log(nowText(r) || "Nothing held here, and nothing waiting.");
      return;
    }
    try {
      let input = {};
      if (f.hook === "stop" && !process.stdin.isTTY) {
        let raw = "";
        for await (const chunk of process.stdin) raw += chunk;
        input = JSON.parse(raw || "{}");
      }
      if (!api.loggedIn()) return;
      // Two or more accounts and nothing saying which: the one thing worth telling the agent at the
      // start of a session, because every call after it would be refused until somebody chooses.
      if (f.hook === "session" && api.needsChoice()) {
        console.log(
          JSON.stringify({
            hookSpecificOutput: {
              hookEventName: "SessionStart",
              additionalContext: `Passalong: ${api.choiceMessage()}`,
            },
          }),
        );
        return;
      }
      // The timeout is cleared as soon as the answer is in. Left running it holds the process open
      // for the full five seconds after the hook has printed, and a session start or a stop that
      // waits five seconds for nothing is the hook getting in the way, which it must never do.
      let timer;
      const r = await Promise.race([
        passalong.now(),
        new Promise((_, no) => {
          timer = setTimeout(() => no(new Error("timeout")), 5000);
        }),
      ]).finally(() => clearTimeout(timer));
      if (f.hook === "session") {
        const text = nowText(r);
        if (text)
          console.log(
            JSON.stringify({
              hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: text },
            }),
          );
      } else if (f.hook === "stop") {
        const v = stopDecision({ held: r.held, input });
        if (v) console.log(JSON.stringify(v));
      }
    } catch {}
  },

  async mcp() {
    const { serve } = await import("../src/mcp.js");
    await serve();
  },

  /**
   * Ask the registry what the latest version is and write it down. Not in the help, because it is
   * not for a person: `passalong` spawns it, detached, when the answer on file is a day old.
   */
  async ["refresh-update"]() {
    const { refresh } = await import("../src/update.js");
    await refresh();
  },

  async help() {
    const src = readFileSync(fileURLToPath(import.meta.url), "utf8");
    const lines = src.split("\n").filter((l) => l.startsWith("//   passalong "));
    console.log("passalong — work for people and agents, and what they know\n");
    console.log(lines.map((l) => l.slice(3)).join("\n"));
  },
};

const argv = flags(process.argv.slice(2));
const cmd = argv._.shift() || "help";
// `--as <name>` says which of the accounts on this machine this one command is for. It exists for an
// agent that was told which by the person, since it has no terminal to be asked at.
if (typeof argv.as === "string") {
  try {
    api.chooseAccount(argv.as);
  } catch (e) {
    die(e.message);
  }
}
// The first thing anyone runs when something is off, and until now it printed the help page. The
// parser only knows `--x`, so `--version` arrives as a flag on an empty command and `-v` as a word;
// both are caught here, with `version`, before dispatch. Only the number goes to stdout, so
// `passalong -v` can be read by a script comparing it against the registry.
if (cmd === "-v" || cmd === "version" || (cmd === "help" && argv.version === true)) {
  console.log(JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version);
} else if (cmd === "--help" || cmd === "-h" || cmd === "help") commands.help();
// A command this build does not have used to print the help page and exit 0, which reads as "that
// command exists and did nothing" — and the usual cause is an older passalong, where the command is
// in the docs and not in the binary. So it fails, names what it does not know, and says the version
// it is, which is the fact that explains it.
else if (!commands[cmd])
  die(
    `unknown command "${cmd}" — run \`passalong help\` for the list. ` +
      `This is passalong ${JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version}; ` +
      "if you expected this command, `npm i -g passalong` for the newest one.",
  );
else {
  // Once per machine; a failure leaves it for the next command rather than failing this one.
  await passalong.tidy().catch(() => {});
  await commands[cmd](argv).catch((e) => die(e.message));
  // After the command, never before it: a version check is not worth a millisecond of somebody's
  // first impression, and it must never be the reason a command felt slow. `mcp` is a server that
  // does not return, and the hooks are read by an agent rather than a person — a line neither of
  // them asked for is noise in a transcript.
  if (!["mcp", "now", "refresh-update"].includes(cmd)) {
    try {
      const { cachedNotice } = await import("../src/update.js");
      const current = JSON.parse(readFileSync(join(PKG, "package.json"), "utf8")).version;
      const { notice, stale } = cachedNotice({ current });
      if (notice) console.error(notice);
      // The refresh is a process this one does not wait for: detached, output thrown away,
      // unref'd so the exit is not held open by it. Measuring the alternative is what settled it —
      // the registry took six to ten seconds to answer, so awaiting it meant every command paid
      // that or the check silently never worked.
      if (stale) {
        const child = spawn(process.execPath, [fileURLToPath(import.meta.url), "refresh-update"], {
          detached: true,
          stdio: "ignore",
        });
        child.unref();
      }
    } catch {
      // Nothing about being out of date is worth failing a command that already worked.
    }
  }
}
